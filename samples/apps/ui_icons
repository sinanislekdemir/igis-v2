procedure main(args: const string[1024]);
begin
  failed := false;
  fail_step := 0;
  step := 0;
  shot := args = "shot";
  black := stdlib.ui_black();
  white := stdlib.ui_white();
  accent := stdlib.ui_accent();

  dragging := false;
  drag_item := -1;
  drag_moved := false;
  drag_dx := 0;
  drag_dy := 0;
  drag_x := 0;
  drag_y := 0;
  selecting := false;
  sel_x := 0;
  sel_y := 0;
  sel_w := 0;
  sel_h := 0;
  last_click_ns := uint(0);
  last_click_item := -1;
  opens := 0;
  moves := 0;
  trashed := 0;

  load_assets();
  labels[0] := "Folder";
  labels[1] := "Document";
  labels[2] := "Terminal";
  item_cell[0] := 0;
  item_cell[1] := 1;
  item_cell[2] := 2;
  item_alive[0] := true;
  item_alive[1] := true;
  item_alive[2] := true;
  selected[0] := false;
  selected[1] := false;
  selected[2] := false;

  pure_checks();

  screen_w := syslib.screen_width();
  screen_h := syslib.screen_height();
  if screen_w = uint(0) then
  begin
    host_checks();
    if failed then
      report_and_exit()
    else
      say("ui_icons: host ok\n");
  end
  else if screen_w < uint(120 + ContentW + 30) or screen_h < uint(80 + ContentH + 30) then
    say("ui_icons: screen too small\n")
  else
  begin
    status := syslib.window_open(120, 80, ContentW, ContentH, "Desktop Icons", id);
    if status <> Ok then
      say("ui_icons: no window\n")
    else
    begin
      status := syslib.window_content_rect(id, rect);
      if status <> Ok then
        say("ui_icons: no content rect\n")
      else
      begin
        grid_x := rect.x + GridX;
        grid_y := rect.y + GridY;
        trash_x := rect.x + rect.w - TrashMargin - TrashSize;
        trash_y := rect.y + rect.h - TrashMargin - TrashSize;
        dirty := false;
        flushed := syslib.event_flush();
        if shot then
        begin
          draw_shot();
          say("ui_icons: ready\n");
          flushed := core.clock();
          while core.clock() - flushed < uint(3000000000) do
            at := 0;
          status := syslib.window_close(id);
          say("ui_icons: done\n");
        end
        else
          kernel_proof();
        report_and_exit();
      end;
    end;
  end;
end;
