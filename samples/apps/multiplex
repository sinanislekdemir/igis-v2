unit multiplex;

// Q39 proof app: wait on several input sources at once.
//
//   run multiplex          wait on the console, the input queue and a stream
//   run multiplex check    stream + input only (deterministic, host-runnable)
//
// The parent spawns `multiplex_sender`, which sends one stream message after a
// short delay and stays alive briefly so the queued bytes are not discarded by
// its close. `core.next_any` then reports the source that became ready:
//
//   1. the stream source (index 2 in the full set, 0 in check mode), then
//      `core.recv` takes "ping";
//   2. a self-injected key event, then `syslib.next_event` consumes it;
//   3. in the full mode, one console line typed by the harness, taken with
//      `core.read_line`.
//
// `core.poll_any` on an empty input queue is `WouldBlock` and leaves `ready`
// untouched. Readiness is a snapshot, not a reservation: the corresponding
// read is authoritative if another task consumed the source in between (here
// there is exactly one consumer, so the values are deterministic).

uses core, stdlib, syslib;

const
  KeyCode = 88 * 65536; // 'X'
  PingBytes = 4;

var
  demo: in_stream[64];
  sources: array[uint, 8];
  single: array[uint, 8];
  count: int;
  ready: int;
  st: Status;
  diag: Diagnostic;
  reason: ExitReason;
  child: int;
  line: string[128];
  msg: bytes[64];
  got: int;
  ev: Event;
  ok: bool;
  full: bool;
  exited_ok: bool;
  stream_index: int;
  flushed: uint;

procedure say(text: const string[0]);
begin
  core.write(text);
end;

procedure check(step: const string[0]; passed: bool);
begin
  if ok then
  begin
    if passed then
    begin
      say("multiplex: ");
      say(step);
      say(" ok\n");
    end
    else
    begin
      ok := false;
      say("multiplex: FAIL ");
      say(step);
      say("\n");
    end;
  end;
end;

procedure classify();
begin
  exited_ok := false;
  case reason of
    Ok: exited_ok := true
    Killed: exited_ok := false
    Faulted(code): exited_ok := false
  end;
end;

procedure make_key();
begin
  ev.kind := KeyDown;
  ev.x := 0;
  ev.y := 0;
  ev.code := uint(KeyCode);
  ev.window := 0;
end;

procedure main(args: const string[1024]);
begin
  ok := true;
  full := not stdlib.starts_with(args, "check");
  stream_index := 2;
  if not full then
    stream_index := 0;

  // Discard key events produced while the shell read the command line.
  flushed := syslib.event_flush();
  st := core.spawn("multiplex_sender", "sender", diag, child);
  check("spawn sender", st = Ok and child > 0);

  // 1. A non-blocking probe with only the (empty) input source is WouldBlock
  // and leaves the destination untouched.
  single[0] := uint(1);
  count := 1;
  ready := -1;
  st := core.poll_any(single, count, ready);
  check("poll empty leaves ready", st = WouldBlock and ready = -1);
  // A bad count is Invalid and also writes nothing.
  ready := -1;
  st := core.poll_any(single, 0, ready);
  check("poll count 0 is Invalid", st = Invalid and ready = -1);

  // 2. The stream arm: the child sends "ping" after a delay, so this call
  // really blocks in `core.next_any` until the send wakes it.
  if full then
  begin
    sources[0] := uint(0);
    sources[1] := uint(1);
    sources[2] := core.stream_source(demo);
    count := 3;
  end
  else
  begin
    sources[0] := core.stream_source(demo);
    sources[1] := uint(1);
    count := 2;
  end;
  ready := -1;
  st := core.next_any(sources, count, ready);
  check("stream source ready", st = Ok and ready = stream_index);
  got := core.recv(demo, msg);
  check(
    "stream message",
    got = PingBytes
      and msg[0] = byte(112)
      and msg[1] = byte(105)
      and msg[2] = byte(110)
      and msg[3] = byte(103));
  // Narrow the set so the closed stream (the sender exits later) cannot win
  // the next wait: only the input source remains.
  sources[0] := uint(1);
  count := 1;

  // 3. The input arm: a self-injected key event makes the input source ready.
  make_key();
  st := syslib.inject_event(ev);
  check("inject input", st = Ok);
  ready := -1;
  st := core.next_any(sources, count, ready);
  check("input source ready", st = Ok and ready = 0);
  st := syslib.next_event(ev);
  check(
    "event consumed",
    st = Ok and ev.kind = KeyDown and ev.code = uint(KeyCode));

  // 4. The console arm, full mode only: one completed line, typed by the
  // harness after the prompt, is reported by the same blocking primitive.
  if full then
  begin
    say("multiplex: waiting for console\n");
    sources[0] := uint(0);
    count := 1;
    ready := -1;
    st := core.next_any(sources, count, ready);
    check("console source ready", st = Ok and ready = 0);
    got := core.read_line(line);
    check(
      "console line",
      got = 4
        and line[0] = byte(116)
        and line[1] = byte(105)
        and line[2] = byte(99)
        and line[3] = byte(107));
  end;

  st := core.wait(child, reason);
  classify();
  check("sender exited Ok", st = Ok and exited_ok);
  if ok then
    say("multiplex: ok\n");
end;
