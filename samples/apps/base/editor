unit editor;

// M2.5.3: a windowed text editor over the read-only application file API.
//
//   run editor               // interactive, opens `base/child`
//   run editor <file>        // interactive, opens that image file
//   run editor check         // deterministic checks, prints `editor: ok`
//   run editor shot [file]   // draws the file, prints `editor: ready` and
//                            // holds ~5 s for the QMP screenshot harness
//
// The document is one `string[8192]` buffer (valid UTF-8 by construction) and
// the view is derived from it on demand: a byte cursor, a scalar selection
// anchor, a first visible line and a horizontal byte offset. Opening a file
// checks the size first (`core.fs_size`), reads it in the API's 256-byte
// chunks into a staged `bytes[8192]`, and publishes the whole buffer with one
// `core.substr_into` (a `bytes` source is the strict UTF-8 conversion), so a
// missing name, a directory, a malformed path, an over-size file or
// invalid UTF-8 leaves the previous document byte-identical. The buffer limit
// is 8192 bytes; a larger file is refused with a status line, not truncated.
//
// Editing is app-local because the M2.4.1 `str_*` mutators declare a 256-byte
// working capacity while this editor's buffer is 8 KiB. The read-only helpers
// (`str_boundary`, `str_cursor_*`, `str_selection_normalize/all/collapse`) take
// `const string[0]` and are reused unchanged; the one mutator is
// `ed_replace`, the same checked prefix/insert/suffix staging rule as
// `str_insert_into`/`str_delete_into` but with this buffer's capacity. It
// requires both range ends to be code-point boundaries, stages into a local
// `bytes[8192]`, converts with `core.substr_into` and publishes with one copy,
// so a rejected edit changes nothing and the document stays valid UTF-8.
//
// Saving is enabled by the M6.3 writable home filesystem (spec 0019, E1). The
// whole document is written to a sibling temporary file (`<target>.tmp`), which
// is then renamed over the target; the temporary is removed first, so a leftover
// from a failed save never leaves a longer tail. A document opened from the
// read-only image is saved as a copy under `home/<basename>` and the editor's
// path switches to it. Without a home disk the save reports that and leaves the
// document and path unchanged.
//
// The File menu's Open re-reads the current path (there is no file picker
// until M2.5.4), Ctrl+O does the same, Ctrl+Q quits and Ctrl+A selects all.
// M9.1 adds lexical syntax highlighting for source files and a File > Highlight
// toggle: `unit`, `var`, `if` and the other keywords are blue, type and
// predeclared names dark red, strings dark green, comments gray and numbers
// dark brown. A file opened from `base/`, `lib/` or `system/`, or ending in
// `.ig`, starts highlighted; other text files stay plain and can be toggled on.
// Block comments (`{ ... }`) carry their state across visible lines; UTF-8 code
// points are never split because token runs use whole code points and the
// drawing path still publishes slices through the checked `core.substr_into`.
// The scrollbar uses `ui_scrollbar`/`ui_scrollbar_hit`: a click on the track
// pages the view and the thumb drags (M9.2, matching the browser's M8.9). Tab
// inserts two spaces, the repository's source indentation.
//
// M9.2 keeps the pointer path cheap: a pointer event repaints only when it
// changes visible state (a plain move over the text does nothing, a menu move
// repaints only when the highlight row changes, a thumb drag only when
// `top_line` changes). The M9.1 block-comment state at every line start is also
// cached in `line_states` and refreshed once per document publication instead
// of rescanning from byte 0 on every frame. Together these remove the full
// repaint per pointer move that spent a normal task's 10 s CPU budget
// (`Faulted(BudgetExceeded)`) when the user moved the mouse over the editor;
// the budget itself is unchanged.
//
// Drawing is client content only: the window service owns the frame, this app
// paints inside its content rectangle and never calls `syslib.clear`. Every
// frame is complete before one `window_present`; an owner `Expose` repaints the
// whole content. The interactive loop blocks in `syslib.next_event` while idle.
//
// `langhost` and a kernel without a framebuffer model a disabled screen, so the
// sample runs the same load/edit/line logic there and prints `editor: host ok`.

uses core, stdlib, syslib, lib.out, lib.inject;

const
  WindowX = 180;
  WindowY = 90;
  ContentW = 640;
  ContentH = 480;

  // Document capacity. The ext2 sources the editor opens in the samples are
  // far below this; `widgets` (57 KiB) is the documented too-large case.
  BufferCapacity = 8192;
  PathCapacity = 64;
  // A save path is `<target>.tmp`, so it can be four bytes longer than a path.
  TempCapacity = 96;

  // Client layout inside the content rectangle.
  MenuBarH = 22;
  MenuW = 160;
  PathTop = 22;
  PathH = 16;
  TextTop = 38;
  LineH = 16;
  Rows = 26;
  TextLeft = 4;
  TextW = 612;
  VisibleCols = 76;
  ScrollLeft = 620;
  ScrollTop = 38;
  ScrollW = 16;
  ScrollH = 416;
  StatusTop = 456;

  // File menu rows: Open, Save, separator, Highlight, Quit.
  FileItemCount = 5;
  FileHighlightItem = 3;
  FileQuitItem = 4;

  // Lexical token classes and the longest word the highlighter compares
  // (`in_stream`/`out_stream` are 10 bytes; 16 leaves headroom).
  ClassDefault = 0;
  ClassKeyword = 1;
  ClassType = 2;
  ClassString = 3;
  ClassComment = 4;
  ClassNumber = 5;
  TokenCapacity = 16;
  KeywordCount = 33;
  TypeCount = 14;
  // One cached block-comment state per line start: an 8192-byte document has
  // at most 8193 lines (one per '\n' plus the final empty line).
  LineStateCapacity = BufferCapacity + 1;

  HoldSeconds = 5;
  NanosPerSecond = 1000000000;

var
  // Document and loading.
  text: string[BufferCapacity];
  load_stage: bytes[BufferCapacity];
  save_stage: bytes[BufferCapacity];
  path: string[PathCapacity];
  save_target: string[PathCapacity];
  save_temp: string[TempCapacity];
  status_line: string[128];
  no_home: bool;

  // View state: caret and selection anchor are byte offsets (code-point
  // boundaries); the selection is the ordered pair, normalized on use.
  caret: int;
  anchor: int;
  top_line: int;
  left_byte: int;
  // M9.2 scrollbar thumb drag: the grab offset is `pointer - thumb top`.
  scroll_dragging: bool;
  scroll_grab_dy: int;

  // File menu.
  open_menu: int;
  selected: int;
  file_items: array[string[64], 16];
  file_keys: array[string[32], 16];
  file_disabled: uint;
  file_checked: uint;
  titles: array[string[32], 8];

  // Lexical highlighting (M9.1): the keyword/type tables are built once at
  // startup; `block_open` carries a `{ ... }` comment across visible lines.
  highlight: bool;
  block_open: bool;
  keywords: array[string[16], 40];
  type_names: array[string[16], 20];
  word_buf: string[TokenCapacity];
  // M9.2: the block-comment state at each line start, refreshed when the
  // document is published; `draw_lines` reads one entry per frame.
  line_states: bytes[LineStateCapacity];

  // Window and absolute layout.
  id: int;
  rect: Rect;
  text_x: int;
  text_y: int;
  scroll_x: int;
  scroll_y: int;
  status_y: int;

  // Palette.
  black: uint;
  white: uint;
  gray: uint;
  accent: uint;
  kw_color: uint;
  type_color: uint;
  string_color: uint;
  comment_color: uint;
  number_color: uint;

  // Mode and scratch.
  mode: int;
  running: bool;
  failed: bool;
  step: int;
  step_text: string[16];
  ev: Event;
  st: Status;
  used: int;
  copied: int;
  tail_buf: string[256];
  digits_line: string[24];
  digits_col: string[24];
  slice_buf: string[512];
  one: bytes[2];
  ch: string[8];
  scratch_bytes: bytes[4];
  scratch_text: string[8];

// Silent check: the first failure is printed with its step number and label.
procedure verify(label: const string[0]; passed: bool);
begin
  step := step + 1;
  if not passed then
  begin
    failed := true;
    out.say("editor: failed check ");
    used := core.format_int_into(step_text, step, uint(10), uint(0));
    out.say(step_text);
    out.say(" (");
    out.say(label);
    out.say(")\n");
  end;
end;

// True when any pixel in the rectangle has exactly `color`. The M9.1 syntax
// probes use it on one glyph row (8 px tall) at a time, so the scan is small.
function region_has_color(x: int; y: int; w: int; h: int; color: uint): bool;
var
  px: int;
  py: int;
begin
  py := y;
  while py < y + h do
  begin
    px := x;
    while px < x + w do
    begin
      if syslib.get_pixel(px, py) = color then
        return true;
      px := px + 1;
    end;
    py := py + 1;
  end;
  return false;
end;

// ---- text geometry (pure over any capacity) ------------------------------

function is_continuation(value: byte): bool;
begin
  return value >= byte(0x80) and value <= byte(0xBF);
end;

// One line per '\n', plus a final empty line when the text ends with one; an
// empty document is one empty line.
function line_count(t: const string[0]): int;
var
  length: int;
  i: int;
  count: int;
begin
  length := int(core.len(t));
  count := 1;
  i := 0;
  while i < length do
  begin
    if t[i] = byte(10) then
      count := count + 1;
    i := i + 1;
  end;
  return count;
end;

// Byte offset of the first byte of `line` (0-based); past the last line yields
// the text length.
function line_start_of(t: const string[0]; line: int): int;
var
  length: int;
  i: int;
  seen: int;
begin
  length := int(core.len(t));
  if line <= 0 then
    return 0;
  i := 0;
  seen := 0;
  while i < length do
  begin
    if t[i] = byte(10) then
    begin
      seen := seen + 1;
      if seen = line then
        return i + 1;
    end;
    i := i + 1;
  end;
  return length;
end;

// Byte offset of the line's terminating '\n', or the text length.
function line_end_of(t: const string[0]; start: int): int;
var
  length: int;
  i: int;
begin
  length := int(core.len(t));
  if start >= length then
    return length;
  i := start;
  while i < length do
  begin
    if t[i] = byte(10) then
      return i;
    i := i + 1;
  end;
  return length;
end;

// 0-based line containing byte offset `pos`.
function line_of_pos(t: const string[0]; pos: int): int;
var
  length: int;
  i: int;
  line: int;
begin
  length := int(core.len(t));
  if pos > length then
    pos := length;
  line := 0;
  i := 0;
  while i < pos do
  begin
    if t[i] = byte(10) then
      line := line + 1;
    i := i + 1;
  end;
  return line;
end;

// Code-point column (draw_text advances one cell per byte; this is the
// human-readable column used by the Ln/Col readout).
function column_of(t: const string[0]; start: int; pos: int): int;
var
  length: int;
  i: int;
  column: int;
begin
  length := int(core.len(t));
  if pos > length then
    pos := length;
  column := 0;
  i := start;
  while i < pos do
  begin
    if not is_continuation(t[i]) then
      column := column + 1;
    i := i + 1;
  end;
  return column;
end;

// Moves `at` back to the nearest code-point boundary at or after `from`.
function snap_boundary(t: const string[0]; from: int; at: int): int;
var
  length: int;
  i: int;
begin
  length := int(core.len(t));
  i := at;
  if i > length then
    i := length;
  while i > from and i < length and is_continuation(t[i]) do
    i := i - 1;
  return i;
end;

// ---- lexical highlighting (M9.1) ----------------------------------------

// The keyword and type tables are fixed arrays built once at startup; no
// allocation, no generic container and no new language feature.

function is_digit(value: byte): bool;
begin
  return value >= byte(48) and value <= byte(57);
end;

function is_hex_digit(value: byte): bool;
begin
  return is_digit(value) or
    (value >= byte(97) and value <= byte(102)) or
    (value >= byte(65) and value <= byte(70));
end;

function is_letter(value: byte): bool;
begin
  return (value >= byte(65) and value <= byte(90)) or
    (value >= byte(97) and value <= byte(122));
end;

function is_ident_start(value: byte): bool;
begin
  return is_letter(value) or value = byte(95);
end;

function is_ident_char(value: byte): bool;
begin
  return is_ident_start(value) or is_digit(value);
end;

// Byte length of the UTF-8 code point at `at` (the text is valid UTF-8, so a
// lead byte always has its full sequence before the line's '\n'); clamped to
// `stop` anyway. Used so a default token never begins or ends inside a code
// point.
function codepoint_length(t: const string[0]; at: int; stop: int): int;
var
  value: byte;
  length: int;
begin
  value := t[at];
  length := 1;
  if value >= byte(0xF0) then
    length := 4
  else if value >= byte(0xE0) then
    length := 3
  else if value >= byte(0xC0) then
    length := 2;
  if at + length > stop then
    length := stop - at;
  return length;
end;

