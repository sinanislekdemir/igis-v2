  keywords[2] := "const";
  keywords[3] := "var";
  keywords[4] := "type";
  keywords[5] := "record";
  keywords[6] := "end";
  keywords[7] := "procedure";
  keywords[8] := "function";
  keywords[9] := "begin";
  keywords[10] := "if";
  keywords[11] := "then";
  keywords[12] := "else";
  keywords[13] := "while";
  keywords[14] := "do";
  keywords[15] := "case";
  keywords[16] := "of";
  keywords[17] := "return";
  keywords[18] := "array";
  keywords[19] := "ring";
  keywords[20] := "map";
  keywords[21] := "in_stream";
  keywords[22] := "out_stream";
  keywords[23] := "value";
  keywords[24] := "and";
  keywords[25] := "or";
  keywords[26] := "not";
  keywords[27] := "div";
  keywords[28] := "mod";
  keywords[29] := "fault";
  keywords[30] := "exit";
  keywords[31] := "true";
  keywords[32] := "false";

  type_names[0] := "int";
  type_names[1] := "uint";
  type_names[2] := "byte";
  type_names[3] := "bool";
  type_names[4] := "f64";
  type_names[5] := "string";
  type_names[6] := "bytes";
  type_names[7] := "Status";
  type_names[8] := "FaultCode";
  type_names[9] := "Diagnostic";
  type_names[10] := "ExitReason";
  type_names[11] := "Rect";
  type_names[12] := "Event";
  type_names[13] := "EventKind";
end;

function classify_word(t: const string[0]; at: int; stop: int): int;
var
  length: int;
  got: int;
  i: int;
begin
  length := stop - at;
  if length > TokenCapacity then
    return ClassDefault;
  got := core.substr_into(word_buf, t, at, length);
  if got <> length then
    return ClassDefault;
  i := 0;
  while i < KeywordCount do
  begin
    if word_buf = keywords[i] then
      return ClassKeyword;
    i := i + 1;
  end;
  i := 0;
  while i < TypeCount do
  begin
    if word_buf = type_names[i] then
      return ClassType;
    i := i + 1;
  end;
  return ClassDefault;
end;

// Classifies the token starting at `at` and sets its exclusive end, its class
// and the block-comment state after it. `//` runs to the line end, `{` opens a
// block comment that ends at the first `}` (no nesting, as the lexer), a
// string runs to its closing quote (with `\"` skipped) or the line end, and
// any other byte is one default code point. A `//` or `{` inside a string is
// string content, and strings/comments skip their interior.
procedure scan_token(t: const string[0]; at: int; stop: int; in_block: bool;
                    out_end: var int; out_class: var int; out_block: var bool);
var
  value: byte;
  i: int;
  exponent: int;
begin
  out_end := at;
  out_class := ClassDefault;
  out_block := in_block;
  if at >= stop then
    return;
  value := t[at];
  if in_block then
  begin
    out_class := ClassComment;
    i := at;
    while i < stop do
    begin
      if t[i] = byte(125) then
      begin
        out_end := i + 1;
        out_block := false;
        return;
      end;
      i := i + 1;
    end;
    out_end := stop;
    out_block := true;
    return;
  end;
  if value = byte(47) and at + 1 < stop and t[at + 1] = byte(47) then
  begin
    out_class := ClassComment;
    out_end := stop;
    return;
  end;
  if value = byte(123) then
  begin
    out_class := ClassComment;
    i := at + 1;
    while i < stop do
    begin
      if t[i] = byte(125) then
      begin
        out_end := i + 1;
        out_block := false;
        return;
      end;
      i := i + 1;
    end;
    out_end := stop;
    out_block := true;
    return;
  end;
  if value = byte(34) then
  begin
    out_class := ClassString;
    i := at + 1;
    while i < stop do
    begin
      if t[i] = byte(92) then
        i := i + 2
      else if t[i] = byte(34) then
      begin
        out_end := i + 1;
        return;
      end
      else
        i := i + 1;
    end;
    out_end := stop;
    return;
  end;
  if is_digit(value) then
  begin
    out_class := ClassNumber;
    i := at;
    if value = byte(48) and i + 1 < stop and
       (t[i + 1] = byte(120) or t[i + 1] = byte(88)) and
       i + 2 < stop and is_hex_digit(t[i + 2]) then
    begin
      i := i + 2;
      while i < stop and is_hex_digit(t[i]) do
        i := i + 1;
    end
    else
    begin
      while i < stop and is_digit(t[i]) do
        i := i + 1;
      if i + 1 < stop and t[i] = byte(46) and is_digit(t[i + 1]) then
      begin
        i := i + 2;
        while i < stop and is_digit(t[i]) do
          i := i + 1;
      end;
      if i < stop and (t[i] = byte(101) or t[i] = byte(69)) then
      begin
        exponent := i + 1;
        if exponent < stop and
           (t[exponent] = byte(43) or t[exponent] = byte(45)) then
          exponent := exponent + 1;
        if exponent < stop and is_digit(t[exponent]) then
        begin
          i := exponent + 1;
          while i < stop and is_digit(t[i]) do
            i := i + 1;
        end;
      end;
    end;
    out_end := i;
    return;
  end;
  if is_ident_start(value) then
  begin
    i := at + 1;
    while i < stop and is_ident_char(t[i]) do
      i := i + 1;
    out_end := i;
    out_class := classify_word(t, at, i);
    return;
  end;
  out_end := at + codepoint_length(t, at, stop);
end;

// Recomputes the block-comment state at every line start (M9.2). This is one
// allocation-free scan of the whole document - a `//` comment ends at its own
// line's '\n', so one line's `//` never swallows a later line's `{` - and it
// runs once whenever the text is published (`publish_staged` from an open or a
// check-mode load, `ed_replace` from an edit), not once per frame. `draw_lines`
// then reads the state for its first visible line from `line_states`, so
// scrolling and dragging cost O(visible lines), not O(document).
procedure refresh_line_states();
var
  length: int;
  total: int;
  start: int;
  stop: int;
  i: int;
  finish: int;
  cls: int;
  state: bool;
  next_state: bool;
  line: int;
begin
  length := int(core.len(text));
  total := line_count(text);
  state := false;
  start := 0;
  line := 0;
  while line < total and line < LineStateCapacity do
  begin
    if state then
      line_states[line] := byte(1)
    else
      line_states[line] := byte(0);
    stop := line_end_of(text, start);
    i := start;
    while i < stop do
    begin
      scan_token(text, i, stop, state, finish, cls, next_state);
      if finish <= i then
        finish := i + 1;
      state := next_state;
      i := finish;
    end;
    if stop < length then
      start := stop + 1
    else
      start := length;
    line := line + 1;
  end;
end;

function class_color(cls: int): uint;
begin
  if cls = ClassKeyword then
    return kw_color;
  if cls = ClassType then
    return type_color;
  if cls = ClassString then
    return string_color;
  if cls = ClassComment then
    return comment_color;
  if cls = ClassNumber then
    return number_color;
  return black;
end;

// A source path is highlighted by default: `base/`, `lib/` and `system/` hold
// source, and a `.ig` suffix names source anywhere. Other text files (for
// example `home/*.txt`) stay plain until the File > Highlight toggle turns
// colouring on.
function is_source_path(name: const string[0]): bool;
var
  length: int;
begin
  if stdlib.starts_with(name, "base/") or stdlib.starts_with(name, "lib/") or
     stdlib.starts_with(name, "system/") then
    return true;
  length := int(core.len(name));
  if length >= 3 and name[length - 3] = byte(46) and
     name[length - 2] = byte(105) and name[length - 1] = byte(103) then
    return true;
  return false;
end;

// ---- editing over the 8 KiB buffer ---------------------------------------

// The single checked mutator: replaces `count` bytes at boundary `at` with
// `ins` (any valid `string`). Both range ends must be boundaries; the result
// is staged in a local `bytes[BufferCapacity]`, converted with
// `core.substr_into` (strict UTF-8) and published with one whole-buffer copy.
// `Invalid` and `CapacityExceeded` change nothing.
function ed_replace(buf: var string[BufferCapacity]; at: int; count: int;
                    ins: const string[0]): Status;
var
  length: int;
  add: int;
  new_length: int;
  i: int;
  raw: bytes[BufferCapacity];
begin
  length := int(core.len(buf));
  if at < 0 or at > length then
    return Invalid;
  if count < 0 or count > length - at then
    return Invalid;
  if not stdlib.str_boundary(buf, at) then
    return Invalid;
  if not stdlib.str_boundary(buf, at + count) then
    return Invalid;
  add := int(core.len(ins));
  new_length := length - count + add;
  if new_length > BufferCapacity then
    return CapacityExceeded;

  i := 0;
  while i < at do
  begin
    raw[i] := buf[i];
    i := i + 1;
  end;
  i := 0;
  while i < add do
  begin
    raw[at + i] := ins[i];
    i := i + 1;
  end;
  i := at + count;
  while i < length do
  begin
    raw[i - count + add] := buf[i];
    i := i + 1;
  end;

  copied := core.substr_into(buf, raw, 0, new_length);
  if copied <> new_length then
    return Invalid;
  // The editor's one document is `text`; refresh the cached per-line block
  // states once per edit, never per frame (M9.2).
  refresh_line_states();
  return Ok;
end;

// Deletes the code point before the clamped cursor and moves it to that code
// point's first byte; at 0 it is an Ok no-op.
function ed_backspace(buf: var string[BufferCapacity]; cursor: var int): Status;
var
  at: int;
  previous: int;
  result: Status;
begin
  at := stdlib.str_cursor_clamp(buf, cursor);
  if at = 0 then
  begin
    cursor := 0;
    return Ok;
  end;
  previous := at - 1;
  while previous > 0 and is_continuation(buf[previous]) do
    previous := previous - 1;
  result := ed_replace(buf, previous, at - previous, "");
  if result = Ok then
    cursor := previous;
  return result;
end;

// Deletes the code point after the cursor; at the end it is an Ok no-op.
function ed_delete_forward(buf: var string[BufferCapacity]; cursor: var int): Status;
var
  at: int;
  next: int;
  value: Status;
begin
  at := stdlib.str_cursor_clamp(buf, cursor);
  if at >= int(core.len(buf)) then
  begin
    cursor := at;
    return Ok;
  end;
  next := at;
  next := stdlib.str_cursor_right(buf, next);
  if next <= at then
  begin
    cursor := at;
    return Ok;
  end;
  value := ed_replace(buf, at, next - at, "");
  return value;
end;

// ---- document load --------------------------------------------------------

procedure set_error(value: Status);
begin
  if value = NotFound then
    status_line := "no such file"
  else if value = Invalid then
    status_line := "not a readable file"
  else if value = CapacityExceeded then
    status_line := "too large (8192 max)"
  else
    status_line := "read error";
end;

// Publishes the first `size` bytes of the staged read as the document. The
// conversion is the API's only bytes -> string path, so invalid UTF-8 leaves
// the old document untouched.
function publish_staged(size: int): Status;
var
  got: int;
begin
  got := core.substr_into(text, load_stage, 0, size);
  if got = size then
  begin
    refresh_line_states();
    return Ok;
  end;
  if got = -6 then
    return CapacityExceeded;
  return Invalid;
end;

// Loads one image file. On success it replaces the document and the path; on
// every failure the document and the path are unchanged and the status line
// names the class of failure.
function open_path(name: const string[0]): Status;
var
  size: uint;
  offset: uint;
  read: int;
  value: Status;
  chunk: bytes[256];
  i: int;
  total: int;
begin
  if int(core.len(name)) > PathCapacity then
  begin
    status_line := "path too long";
    return CapacityExceeded;
  end;
  value := core.fs_size(name, size);
  if value <> Ok then
  begin
    set_error(value);
    return value;
  end;
  if size > uint(BufferCapacity) then
  begin
    status_line := "too large (8192 max)";
    return CapacityExceeded;
  end;
  total := int(size);
  offset := uint(0);
  value := Ok;
  while offset < size and value = Ok do
  begin
    value := core.fs_read(name, offset, chunk, read);
    if value = Ok then
    begin
      if read <= 0 then
        value := IoError
      else
      begin
        i := 0;
        while i < read do
        begin
          load_stage[int(offset) + i] := chunk[i];
          i := i + 1;
        end;
        offset := offset + uint(read);
      end;
    end;
  end;
  if value <> Ok then
  begin
    set_error(value);
    return value;
  end;
  if int(offset) <> total then
  begin
    status_line := "read error";
    return IoError;
  end;
  value := publish_staged(total);
  if value <> Ok then
  begin
    status_line := "invalid UTF-8";
    return value;
  end;
  used := core.substr_into(path, name, 0, int(core.len(name)));
  highlight := is_source_path(path);
  file_checked := stdlib.ui_menu_set(
    file_checked, FileHighlightItem, highlight);
  caret := 0;
  anchor := 0;
  top_line := 0;
  left_byte := 0;
  status_line := "opened";
  return Ok;
end;

// Builds `save_target` (the document, or `home/<basename>` for a read-only
// source) and `save_temp` (`save_target` plus `.tmp`) from `path`.
function build_save_paths(): Status;
var
  length: int;
  start: int;
  name_len: int;
  total: int;
  i: int;
  got: int;
  stage: bytes[TempCapacity];
begin
  length := int(core.len(path));
  if length = 0 then
    return Invalid;
  if stdlib.starts_with(path, "home/") then
  begin
    got := core.substr_into(save_target, path, 0, length);
    if got <> length then
      return CapacityExceeded;
  end
  else
  begin
    // The basename of the image path becomes `home/<basename>`.
    start := length;
    while start > 0 and path[start - 1] <> byte(47) do
      start := start - 1;
    name_len := length - start;
    total := 5 + name_len;
    if total > PathCapacity then
      return CapacityExceeded;
    stage[0] := byte(104);  // h
    stage[1] := byte(111);  // o
    stage[2] := byte(109);  // m
    stage[3] := byte(101);  // e
    stage[4] := byte(47);   // /
    i := 0;
    while i < name_len do
    begin
      stage[5 + i] := path[start + i];
      i := i + 1;
    end;
    got := core.substr_into(save_target, stage, 0, total);
    if got <> total then
      return CapacityExceeded;
  end;

  // The temporary sits beside the target so the rename stays in one directory.
  length := int(core.len(save_target));
  total := length + 4;
  if total > TempCapacity then
    return CapacityExceeded;
  i := 0;
  while i < length do
  begin
    stage[i] := save_target[i];
    i := i + 1;
  end;
  stage[length] := byte(46);      // .
  stage[length + 1] := byte(116); // t
  stage[length + 2] := byte(109); // m
  stage[length + 3] := byte(112); // p
  got := core.substr_into(save_temp, stage, 0, total);
  if got <> total then
    return CapacityExceeded;
  return Ok;
end;

// The failure status line; an absent mount is the `Invalid` the first remove
// call reports.
procedure set_save_error(value: Status);
begin
  if value = Invalid then
  begin
    no_home := true;
    status_line := "no writable home";
  end
  else if value = NotFound then
    status_line := "no such directory"
  else if value = CapacityExceeded then
    status_line := "no space left"
  else
    status_line := "save failed";
end;

// Compares the saved target with the document, byte for byte.
function saved_matches(): bool;
var
  length: int;
  offset: int;
  read: int;
  i: int;
  size: uint;
  same: bool;
  value: Status;
  chunk: bytes[256];
begin
  length := int(core.len(text));
  value := core.fs_size(save_target, size);
  if value <> Ok or int(size) <> length then
    return false;
  offset := 0;
  same := true;
  while offset < length and same do
  begin
    value := core.fs_read(save_target, uint(offset), chunk, read);
    if value <> Ok or read <= 0 then
      same := false
    else
    begin
      i := 0;
      while i < read do
      begin
        if chunk[i] <> text[offset + i] then
          same := false;
        i := i + 1;
      end;
      offset := offset + read;
    end;
  end;
  return same and offset = length;
end;

// Sets `saved` or `saved <target>` in the status line.
procedure set_saved_status(copied: bool);
var
  total: int;
  i: int;
  got: int;
  stage: bytes[128];
begin
  if not copied then
    status_line := "saved"
  else
  begin
    total := 6 + int(core.len(save_target));
    if total > 128 then
      total := 128;
    stage[0] := byte(115); // s
    stage[1] := byte(97);  // a
    stage[2] := byte(118); // v
    stage[3] := byte(101); // e
    stage[4] := byte(100); // d
    stage[5] := byte(32);  // space
    i := 0;
    while i < total - 6 do
    begin
      stage[6 + i] := save_target[i];
      i := i + 1;
    end;
    got := core.substr_into(status_line, stage, 0, total);
    if got <> total then
      status_line := "saved";
  end;
end;

procedure try_save();
var
  length: int;
  staged: int;
  written: int;
  value: Status;
  source_is_home: bool;
begin
  no_home := false;
  if int(core.len(path)) = 0 then
  begin
    status_line := "no file";
    return;
  end;
  value := build_save_paths();
  if value <> Ok then
  begin
    status_line := "path too long";
    return;
  end;
  source_is_home := stdlib.starts_with(path, "home/");

  length := int(core.len(text));
  staged := core.substr_into(save_stage, text, 0, length);
  if staged <> length then
  begin
    status_line := "save failed";
    return;
  end;

  // Remove a leftover temporary first: without truncate, a stale, longer file
  // would keep its tail after the shorter write.
  value := core.fs_remove(save_temp);
  if value = Invalid then
  begin
    no_home := true;
    status_line := "no writable home";
    return;
  end
  else if value <> Ok and value <> NotFound then
  begin
    set_save_error(value);
    return;
  end;

  written := -1;
  value := core.fs_write(save_temp, uint(0), save_stage, written);
  if value <> Ok or written <> length then
  begin
    if value = Ok then
      status_line := "save failed"
    else
      set_save_error(value);
    return;
  end;
  value := core.fs_rename(save_temp, save_target);
  if value <> Ok then
  begin
    set_save_error(value);
    return;
  end;

  if not source_is_home then
  begin
    // The copy is the document now.
    copied := core.substr_into(path, save_target, 0, int(core.len(save_target)));
    if copied <> int(core.len(save_target)) then
    begin
      status_line := "path too long";
      return;
    end;
    set_saved_status(true);
  end
  else
    set_saved_status(false);
end;

// ---- selection and cursor movement ---------------------------------------

procedure selection_bounds(out_first: var int; out_last: var int);
var
  first: int;
  last: int;
begin
  first := anchor;
  last := caret;
  used := stdlib.str_selection_normalize(text, first, last);
  out_first := first;
  out_last := last;
end;

procedure collapse_to(position: int);
begin
  caret := position;
  anchor := position;
end;

// Keeps the caret line inside the vertical window and the caret column inside
// the horizontal window; both offsets snap back to code-point boundaries.
procedure ensure_visible();
var
  length: int;
  line: int;
  start: int;
  column: int;
  absolute: int;
  i: int;
  total: int;
begin
  length := int(core.len(text));
  line := line_of_pos(text, caret);
  start := line_start_of(text, line);
  column := caret - start;
  if column < left_byte then
    left_byte := column;
  if column - left_byte >= VisibleCols then
    left_byte := column - VisibleCols + 1;
  if left_byte < 0 then
    left_byte := 0;
  absolute := start + left_byte;
  i := absolute;
  while i > start and i < length and is_continuation(text[i]) do
    i := i - 1;
  left_byte := i - start;

  if line < top_line then
    top_line := line;
  if line >= top_line + Rows then
    top_line := line - Rows + 1;
  total := line_count(text);
  top_line := stdlib.ui_scrollbar_clamp(top_line, Rows, total);
  if top_line < 0 then
    top_line := 0;
end;

// Replaces the ordered selection with `ins` and collapses the selection just
// past the inserted text. The failure paths leave everything untouched.
procedure replace_selection(ins: const string[0]);
var
  first: int;
  last: int;
  value: Status;
begin
  selection_bounds(first, last);
  value := ed_replace(text, first, last - first, ins);
  if value = Ok then
  begin
    caret := first + int(core.len(ins));
    anchor := caret;
    status_line := "";
  end
  else if value = CapacityExceeded then
    status_line := "buffer full (8192 bytes)"
  else
    status_line := "edit refused";
  ensure_visible();
end;

// One printable byte from a key event, converted through the checked
// bytes -> string path (ASCII, so it is always valid).
procedure type_char(value: byte);
var
  got: int;
begin
  one[0] := value;
  got := core.substr_into(ch, one, 0, 1);
  if got = 1 then
    replace_selection(ch)
  else
    status_line := "bad character";
end;

// Plain left/right: collapse a live selection to the edge in that direction,
// otherwise move one whole code point.
procedure move_horizontal(delta: int);
var
  first: int;
  last: int;
begin
  selection_bounds(first, last);
  if first <> last then
  begin
    if delta < 0 then
      collapse_to(first)
    else
      collapse_to(last);
  end
  else if delta < 0 then
    caret := stdlib.str_cursor_left(text, caret)
  else
    caret := stdlib.str_cursor_right(text, caret);
  anchor := caret;
  ensure_visible();
end;

// Shift+left/right: keep the anchor and move the active end.
procedure extend_horizontal(delta: int);
begin
  if delta < 0 then
    caret := stdlib.str_cursor_left(text, caret)
  else
    caret := stdlib.str_cursor_right(text, caret);
  ensure_visible();
end;

// Moves the caret `delta` lines, keeping the byte column when it fits; a
// target inside a multi-byte code point snaps back to its first byte.
procedure move_vertical(delta: int; extend: bool);
var
  line: int;
  start: int;
  column: int;
  total: int;
  target: int;
  target_start: int;
  target_end: int;
  position: int;
begin
  line := line_of_pos(text, caret);
  start := line_start_of(text, line);
  column := caret - start;
  total := line_count(text);
  target := line + delta;
  if target < 0 then
    target := 0;
  if target > total - 1 then
    target := total - 1;
  target_start := line_start_of(text, target);
  target_end := line_end_of(text, target_start);
  position := target_start + column;
  if position > target_end then
    position := target_end;
  position := snap_boundary(text, target_start, position);
  if not extend then
    anchor := position;
  caret := position;
  ensure_visible();
end;

// Home/End; `to_file` jumps to the document ends (Ctrl+Home/Ctrl+End).
procedure line_home(extend: bool; to_file: bool);
var
  line: int;
  start: int;
begin
  if to_file then
    start := 0
  else
  begin
    line := line_of_pos(text, caret);
    start := line_start_of(text, line);
  end;
  if not extend then
    anchor := start;
  caret := start;
  ensure_visible();
end;

procedure line_end_move(extend: bool; to_file: bool);
var
  line: int;
  start: int;
  stop: int;
begin
  if to_file then
    stop := int(core.len(text))
  else
  begin
    line := line_of_pos(text, caret);
    start := line_start_of(text, line);
    stop := line_end_of(text, start);
  end;
  if not extend then
    anchor := stop;
  caret := stop;
  ensure_visible();
end;

procedure delete_selection_or_backspace();
var
  first: int;
  last: int;
  value: Status;
begin
  if anchor <> caret then
  begin
    selection_bounds(first, last);
    value := ed_replace(text, first, last - first, "");
    if value = Ok then
      collapse_to(first)
    else
      status_line := "edit refused";
  end
  else
  begin
    value := ed_backspace(text, caret);
    if value = CapacityExceeded then
      status_line := "buffer full"
    else if value <> Ok then
      status_line := "edit refused";
    anchor := caret;
  end;
  ensure_visible();
end;

procedure delete_selection_or_next();
var
  first: int;
  last: int;
  value: Status;
begin
  if anchor <> caret then
  begin
    selection_bounds(first, last);
    value := ed_replace(text, first, last - first, "");
    if value = Ok then
      collapse_to(first)
    else
      status_line := "edit refused";
  end
  else
  begin
    value := ed_delete_forward(text, caret);
    if value = CapacityExceeded then
      status_line := "buffer full"
    else if value <> Ok then
      status_line := "edit refused";
    anchor := caret;
  end;
  ensure_visible();
end;

// ---- menu model ----------------------------------------------------------

procedure setup_menu();
begin
  titles[0] := "File";
  file_items[0] := "Open";
  file_items[1] := "Save";
  file_items[2] := "-";
  file_items[3] := "Highlight";
  file_items[4] := "Quit";
  file_keys[0] := "Ctrl+O";
  file_keys[1] := "Ctrl+S";
  file_keys[2] := "";
  file_keys[3] := "";
  file_keys[4] := "Ctrl+Q";
  // Every row is enabled now that the home filesystem is writable; the
  // separator is never selectable regardless of the mask.
  file_disabled := uint(0);
end;

procedure close_menu();
begin
  open_menu := stdlib.ui_menu_close();
  selected := -1;
end;

procedure open_file_menu();
begin
  open_menu := stdlib.ui_menu_open(
    0, FileItemCount, file_items, file_disabled, selected);
end;

// The File > Highlight toggle: lexical colouring on/off and the menu check
// mark stay in step. The caller redraws the frame.
procedure toggle_highlight();
begin
  highlight := not highlight;
  file_checked := stdlib.ui_menu_set(
    file_checked, FileHighlightItem, highlight);
  if highlight then
    status_line := "syntax on"
  else
    status_line := "syntax off";
end;

procedure activate_menu(index: int);
begin
  if index = 0 then
  begin
    close_menu();
    st := open_path(path);
  end
  else if index = 1 then
  begin
    close_menu();
    try_save();
  end
  else if index = FileHighlightItem then
  begin
    close_menu();
    toggle_highlight();
  end
  else if index = FileQuitItem then
  begin
    close_menu();
    running := false;
  end;
end;

// ---- key handling --------------------------------------------------------

procedure handle_key();
var
  key: int;
  mods: int;
  ctrl: bool;
  shift: bool;
  action: int;
  text_byte: byte;
begin
  key := stdlib.ui_key_code(ev.code);
  mods := stdlib.ui_key_modifiers(ev.code);
  ctrl := (mods div 2) mod 2 = 1;
  shift := mods mod 2 = 1;

  if open_menu >= 0 then
  begin
    action := stdlib.ui_menu_key(ev.code, true);
    if action = 6 then
      close_menu()
    else if action = 1 then
      selected := stdlib.ui_menu_move(
        selected, FileItemCount, -1, file_items, file_disabled)
    else if action = 2 then
      selected := stdlib.ui_menu_move(
        selected, FileItemCount, 1, file_items, file_disabled)
    else if action = 5 then
    begin
      if selected >= 0 and
         stdlib.ui_menu_selectable(file_items[selected], file_disabled, selected) then
        activate_menu(selected);
    end;
    return;
  end;

  if ctrl then
  begin
    if key = 0x73 or key = 0x53 then
    begin
      try_save();
      return;
    end;
    if key = 0x71 or key = 0x51 then
    begin
      running := false;
      return;
    end;
    if key = 0x6F or key = 0x4F then
    begin
      st := open_path(path);
      return;
    end;
    if key = 0x61 or key = 0x41 then
    begin
      used := stdlib.str_selection_all(text, anchor, caret);
      ensure_visible();
      return;
    end;
  end;

  if key = 0x100 then
    return;

  if stdlib.ui_key_is_backspace(ev.code) then
    delete_selection_or_backspace()
  else if stdlib.ui_key_is_delete(ev.code) then
    delete_selection_or_next()
  else if stdlib.ui_key_is_enter(ev.code) then
    replace_selection("\n")
  else if stdlib.ui_key_is_tab(ev.code) then
    replace_selection("  ")
  else if stdlib.ui_key_is_left(ev.code) then
  begin
    if shift then
      extend_horizontal(-1)
    else
      move_horizontal(-1);
  end
  else if stdlib.ui_key_is_right(ev.code) then
  begin
    if shift then
      extend_horizontal(1)
    else
      move_horizontal(1);
  end
  else if stdlib.ui_key_is_up(ev.code) then
    move_vertical(-1, shift)
  else if stdlib.ui_key_is_down(ev.code) then
    move_vertical(1, shift)
  else if key = 0x116 then
    move_vertical(0 - Rows, shift)
  else if key = 0x117 then
    move_vertical(Rows, shift)
  else if stdlib.ui_key_is_home(ev.code) then
    line_home(shift, ctrl)
  else if stdlib.ui_key_is_end(ev.code) then
    line_end_move(shift, ctrl)
  else
  begin
    text_byte := stdlib.ui_key_text(ev.code);
    if text_byte >= byte(32) and text_byte < byte(127) then
      type_char(text_byte);
  end;
end;

// ---- pointer handling ----------------------------------------------------

// Sets the caret to the first line of the view when a scrollbar action moved
// the view past it, or to the last visible line when it moved above it; the
// selection collapses. Without this a page click or a thumb drag could leave
// the caret line off screen and the next key would jump the view back (M9.2).
procedure clamp_caret_to_view();
var
  line: int;
begin
  line := line_of_pos(text, caret);
  if line < top_line then
  begin
    caret := line_start_of(text, top_line);
    anchor := caret;
  end
  else if line >= top_line + Rows then
  begin
    line := top_line + Rows - 1;
    caret := line_start_of(text, line);
    anchor := caret;
  end;
end;

// The current scrollbar thumb geometry, matching `stdlib.ui_scrollbar`: the
// track is `ScrollH - 4` tall, the thumb is the visible fraction with an
// 8-pixel floor (clamped to the track), and it travels over `track - thumb`.
// The drag handler and the check-mode proof use the same arithmetic (M9.2).
procedure scrollbar_thumb(thumb_y: var int; thumb_h: var int);
var
  track_h: int;
  total: int;
  max: int;
  pos: int;
  travel: int;
begin
  track_h := ScrollH - 4;
  total := line_count(text);
  if total <= 0 then
    thumb_h := track_h
  else
  begin
    if Rows <= 0 then
      thumb_h := 8
    else
      thumb_h := (track_h * Rows) div total;
    if thumb_h < 8 then
      thumb_h := 8;
    if thumb_h > track_h then
      thumb_h := track_h;
  end;
  max := total - Rows;
  if max < 0 then
    max := 0;
  pos := stdlib.ui_scrollbar_clamp(top_line, Rows, total);
  travel := track_h - thumb_h;
  thumb_y := scroll_y + 2;
  if max > 0 and travel > 0 then
    thumb_y := scroll_y + 2 + (travel * pos) div max;
end;

// Places the caret and returns true only when the caret, the selection or the
// view actually changed, so a click that lands where the caret already is does
// not repaint (M9.2).
function click_text(px: int; py: int): bool;
var
  row: int;
  line: int;
  total: int;
  start: int;
  stop: int;
  column: int;
  position: int;
  was_caret: int;
  was_anchor: int;
  was_top: int;
  was_left: int;
begin
  was_caret := caret;
  was_anchor := anchor;
  was_top := top_line;
  was_left := left_byte;
  row := (py - text_y) div LineH;
  if row < 0 then
    row := 0;
  line := top_line + row;
  total := line_count(text);
  if line > total - 1 then
    line := total - 1;
  if line < 0 then
    line := 0;
  start := line_start_of(text, line);
  stop := line_end_of(text, start);
  column := (px - text_x) div 8 + left_byte;
  if column < left_byte then
    column := left_byte;
  position := start + column;
  if position > stop then
    position := stop;
  if position < start then
    position := start;
  position := snap_boundary(text, start, position);
  collapse_to(position);
  ensure_visible();
  return caret <> was_caret or anchor <> was_anchor or
    top_line <> was_top or left_byte <> was_left;
end;

// A track click pages by `action`; returns whether the view (or the clamped
// caret) moved.
function page_scroll(action: int): bool;
var
  total: int;
  was_top: int;
  was_caret: int;
  was_anchor: int;
begin
  total := line_count(text);
  was_top := top_line;
  was_caret := caret;
  was_anchor := anchor;
  if action = 1 then
    top_line := stdlib.ui_scrollbar_clamp(top_line - Rows, Rows, total)
  else if action = 2 then
    top_line := stdlib.ui_scrollbar_clamp(top_line + Rows, Rows, total);
  clamp_caret_to_view();
  return top_line <> was_top or caret <> was_caret or anchor <> was_anchor;
end;

// Handles one pointer event and returns whether anything visible changed
// (M9.2). The interactive loop repaints only on true: a no-button move over
// the text and a move that keeps the same menu row are free, and a thumb drag
// repaints only while `top_line` changes. A press on the thumb itself starts
// the drag without repainting; release ends it without repainting.
function handle_pointer(): bool;
var
  bar: int;
  row: int;
  action: int;
  was_menu: int;
  was_selected: int;
  was_top: int;
  was_caret: int;
  was_anchor: int;
  thumb_y: int;
  thumb_h: int;
  travel: int;
  max_top: int;
  desired: int;
begin
  // A grabbed thumb follows the pointer while the primary button is held; a
  // release or a move without the button ends the drag (M9.2, like M8.9).
  if scroll_dragging then
  begin
    if ev.kind = PointerUp then
    begin
      scroll_dragging := false;
      return false;
    end;
    if ev.kind = PointerMove then
    begin
      if ev.code mod uint(2) <> uint(1) then
      begin
        scroll_dragging := false;
        return false;
      end;
      was_top := top_line;
      was_caret := caret;
      was_anchor := anchor;
      scrollbar_thumb(thumb_y, thumb_h);
      travel := (ScrollH - 4) - thumb_h;
      max_top := line_count(text) - Rows;
      if max_top < 0 then
        max_top := 0;
      if travel > 0 and max_top > 0 then
      begin
        desired := ev.y - scroll_grab_dy;
        if desired < scroll_y + 2 then
          desired := scroll_y + 2;
        if desired > scroll_y + 2 + travel then
          desired := scroll_y + 2 + travel;
        top_line := ((desired - (scroll_y + 2)) * max_top) div travel;
        top_line := stdlib.ui_scrollbar_clamp(
          top_line, Rows, line_count(text));
        clamp_caret_to_view();
      end;
      return top_line <> was_top or caret <> was_caret or anchor <> was_anchor;
    end;
    return false;
  end;

  if ev.kind = PointerDown then
  begin
    bar := stdlib.ui_menu_bar_hit(rect.x, rect.y, ContentW, titles, 1, ev.x, ev.y);
    if bar = 0 then
    begin
      if open_menu = 0 then
        close_menu()
      else
        open_file_menu();
      return true;
    end;
    if open_menu >= 0 then
    begin
      was_selected := selected;
      row := stdlib.ui_menu_hit(
        rect.x + 4, rect.y + MenuBarH, MenuW, file_items, FileItemCount,
        ev.x, ev.y);
      if row >= 0 then
      begin
        if stdlib.ui_menu_selectable(file_items[row], file_disabled, row) then
          selected := row;
      end
      else
        close_menu();
      return open_menu < 0 or selected <> was_selected;
    end;
    if stdlib.ui_rect_hit(text_x, text_y, TextW, ScrollH, ev.x, ev.y) then
      return click_text(ev.x, ev.y);
    if stdlib.ui_rect_hit(scroll_x, scroll_y, ScrollW, ScrollH, ev.x, ev.y) then
    begin
      action := stdlib.ui_scrollbar_hit(
        scroll_x, scroll_y, ScrollW, ScrollH, ev.x, ev.y,
        top_line, Rows, line_count(text));
      if action = 3 then
      begin
        scrollbar_thumb(thumb_y, thumb_h);
        scroll_dragging := true;
        scroll_grab_dy := ev.y - thumb_y;
        return false;
      end;
      return page_scroll(action);
    end;
    return false;
  end
  else if ev.kind = PointerUp then
  begin
    if open_menu >= 0 then
    begin
      was_menu := open_menu;
      row := stdlib.ui_menu_hit(
        rect.x + 4, rect.y + MenuBarH, MenuW, file_items, FileItemCount,
        ev.x, ev.y);
      if row >= 0 and row = selected and
         stdlib.ui_menu_selectable(file_items[row], file_disabled, row) then
        activate_menu(row)
      else if row < 0 then
        close_menu();
      return open_menu <> was_menu;
    end;
    return false;
  end
  else if ev.kind = PointerMove then
  begin
    if open_menu >= 0 then
    begin
      was_selected := selected;
      row := stdlib.ui_menu_hit(
        rect.x + 4, rect.y + MenuBarH, MenuW, file_items, FileItemCount,
        ev.x, ev.y);
      if row >= 0 and stdlib.ui_menu_selectable(file_items[row], file_disabled, row) then
        selected := row;
      return selected <> was_selected;
    end;
    return false;
  end;
  return false;
end;

// ---- drawing -------------------------------------------------------------

procedure compute_layout();
begin
  text_x := rect.x + TextLeft;
  text_y := rect.y + TextTop;
  scroll_x := rect.x + ScrollLeft;
  scroll_y := rect.y + ScrollTop;
  status_y := rect.y + StatusTop;
end;

// Re-reads the content rectangle after the service moved the window and
// recomputes the cached layout (spec 0011, W12/W17/W28; ADR 0046). The app
// draws and hit-tests in absolute screen coordinates.
procedure refresh_layout();
begin
  st := syslib.window_content_rect(id, rect);
  if st = Ok then
    compute_layout();
end;

// One horizontal slice of the current line, from `left` (the byte shown at
// text_x, used for x) to `to`; both ends are boundaries and the range is at
// most `VisibleCols` bytes.
procedure draw_segment(left: int; from: int; to: int; y: int; color: uint);
var
  got: int;
  at: int;
begin
  if to <= from then
    return;
  at := snap_boundary(text, from, to);
  if at <= from then
    return;
  got := core.substr_into(slice_buf, text, from, at - from);
  if got > 0 then
    st := syslib.draw_text(text_x + (from - left) * 8, y + 4, slice_buf, color);
end;

// One document line with its selection band. The accent is painted behind the
// glyphs and the selected cells are redrawn white, so the band and its text
// stay readable; the unselected parts are black.
procedure draw_line(start: int; stop: int; y: int);
var
  from: int;
  to: int;
  first: int;
  last: int;
  band_from: int;
  band_to: int;
begin
  from := start + left_byte;
  if from > stop then
    from := stop;
  to := stop;
  if to > from + VisibleCols then
    to := from + VisibleCols;
  to := snap_boundary(text, from, to);
  if to < from then
    to := from;
  selection_bounds(first, last);
  band_from := from;
  if first > band_from then
    band_from := first;
  band_to := to;
  if last < band_to then
    band_to := last;
  if band_from < band_to then
  begin
    st := syslib.fill_rect(
      text_x + (band_from - from) * 8, y + 2,
      (band_to - band_from) * 8, 12, accent);
    draw_segment(from, from, band_from, y, black);
    draw_segment(from, band_from, band_to, y, white);
    draw_segment(from, band_to, to, y, black);
  end
  else
    draw_segment(from, from, to, y, black);
end;

// One line with lexical colours (M9.1). `block_open` is the block-comment
// state at the line start and is left at the line end, so `draw_lines` carries
// it to the next visible line. The whole line is scanned (even the part left
// of `left_byte`) so a comment opened before the visible span still colours
// it; only the visible span is drawn, in at most three pieces around the
// selection band. Runs of default bytes are merged into one draw call, so a
// line of plain text costs one `draw_text`.
procedure draw_syntax_line(start: int; stop: int; y: int);
var
  from: int;
  to: int;
  first: int;
  last: int;
  band_from: int;
  band_to: int;
  i: int;
  finish: int;
  cls: int;
  step: int;
  state: bool;
  next_state: bool;
  grouping: bool;
  a: int;
  b: int;
  ink: uint;
  part_from: int;
  part_to: int;
begin
  from := start + left_byte;
  if from > stop then
    from := stop;
  to := stop;
  if to > from + VisibleCols then
    to := from + VisibleCols;
  to := snap_boundary(text, from, to);
  if to < from then
    to := from;
  selection_bounds(first, last);
  band_from := from;
  if first > band_from then
    band_from := first;
  band_to := to;
  if last < band_to then
    band_to := last;
  if band_from < band_to then
    st := syslib.fill_rect(
      text_x + (band_from - from) * 8, y + 2,
      (band_to - band_from) * 8, 12, accent);

  state := block_open;
  i := start;
  while i < stop do
  begin
    scan_token(text, i, stop, state, finish, cls, next_state);
    state := next_state;
    if finish <= i then
      finish := i + 1;
    if cls = ClassDefault then
    begin
      // Merge all following default bytes (whitespace, punctuation, whole
      // non-ASCII code points) until a token that needs its own colour.
      grouping := true;
      while finish < stop and grouping do
      begin
        if text[finish] = byte(47) and finish + 1 < stop and
           text[finish + 1] = byte(47) then
          grouping := false
        else if text[finish] = byte(123) or text[finish] = byte(34) or
                is_digit(text[finish]) or is_ident_start(text[finish]) then
          grouping := false
        else
        begin
          step := codepoint_length(text, finish, stop);
          if step <= 0 then
            grouping := false
          else
            finish := finish + step;
        end;
      end;
    end;

    ink := class_color(cls);
    a := i;
    if a < from then
      a := from;
    b := finish;
    if b > to then
      b := to;
    if a < b then
    begin
      // The unselected span before the band keeps the token colour.
      part_from := a;
      part_to := b;
      if part_to > band_from then
        part_to := band_from;
      if part_to > part_from then
        draw_segment(from, part_from, part_to, y, ink);

      // Selected cells are white on the accent band, as before.
      part_from := a;
      if part_from < band_from then
        part_from := band_from;
      part_to := b;
      if part_to > band_to then
        part_to := band_to;
      if part_to > part_from then
        draw_segment(from, part_from, part_to, y, white);

      // The unselected span after the band.
      part_from := a;
      if part_from < band_to then
        part_from := band_to;
      part_to := b;
      if part_to > part_from then
        draw_segment(from, part_from, part_to, y, ink);
    end;
    i := finish;
  end;
  block_open := state;
end;

procedure draw_lines();
var
  total: int;
  length: int;
  start: int;
  stop: int;
  row: int;
  line: int;
  y: int;
  column: int;
  caret_line: int;
  caret_start: int;
begin
  length := int(core.len(text));
  total := line_count(text);
  start := line_start_of(text, top_line);
  if highlight then
  begin
    // M9.2: the block-comment state at the first visible line was cached when
    // the document was published; only the visible lines are scanned per
    // frame, not the document from byte 0.
    line := top_line;
    if line < 0 then
      line := 0;
    if line >= total then
      line := total - 1;
    block_open := line_states[line] <> byte(0);
  end;
  row := 0;
  while row < Rows do
  begin
    line := top_line + row;
    if line < total then
    begin
      stop := line_end_of(text, start);
      y := text_y + row * LineH;
      if highlight then
        draw_syntax_line(start, stop, y)
      else
        draw_line(start, stop, y);
      if stop < length then
        start := stop + 1
      else
        start := length;
    end;
    row := row + 1;
  end;

  caret_line := line_of_pos(text, caret);
  if caret_line >= top_line and caret_line < top_line + Rows then
  begin
    caret_start := line_start_of(text, caret_line);
    column := caret - caret_start;
    if column >= left_byte and column - left_byte <= VisibleCols then
    begin
      y := text_y + (caret_line - top_line) * LineH;
      st := syslib.fill_rect(
        text_x + (column - left_byte) * 8, y + 3, 1, 10, black);
    end;
  end;
end;

procedure draw_path_line();
var
  width: int;
begin
  if int(core.len(path)) = 0 then
    st := syslib.draw_text(rect.x + 8, rect.y + PathTop + 4, "(no file)", gray)
  else
    st := syslib.draw_text(rect.x + 8, rect.y + PathTop + 4, path, black);
  width := stdlib.ui_text_width("Ctrl+S save");
  st := syslib.draw_text(
    rect.x + ContentW - 8 - width, rect.y + PathTop + 4, "Ctrl+S save", gray);
  st := stdlib.ui_separator(rect.x, rect.y + PathTop + PathH - 1, ContentW);
end;

procedure draw_status();
var
  line: int;
  start: int;
  column: int;
  label_w: int;
  x: int;
begin
  st := stdlib.ui_separator(rect.x, status_y - 2, ContentW);
  st := syslib.draw_text(rect.x + 8, status_y + 4, status_line, black);

  line := line_of_pos(text, caret);
  start := line_start_of(text, line);
  column := column_of(text, start, caret);
  used := core.format_int_into(digits_line, line + 1, uint(10), uint(0));
  used := core.format_int_into(digits_col, column + 1, uint(10), uint(0));
  label_w := (3 + int(core.len(digits_line)) + 6 + int(core.len(digits_col))) * 8;
  x := rect.x + ContentW - 8 - label_w;
  st := syslib.draw_text(x, status_y + 4, "Ln ", gray);
  st := syslib.draw_text(x + 24, status_y + 4, digits_line, black);
  st := syslib.draw_text(
    x + 24 + int(core.len(digits_line)) * 8, status_y + 4, ", Col ", gray);
  st := syslib.draw_text(
    x + 24 + int(core.len(digits_line)) * 8 + 48, status_y + 4, digits_col, black);
end;

procedure draw_dropdown();
begin
  st := stdlib.ui_menu_dropdown(
    rect.x + 4, rect.y + MenuBarH, MenuW, file_items, file_keys, FileItemCount,
    selected, file_checked, file_disabled, true);
end;

// One complete frame: background, menu, path line, text view, carets,
// scrollbar, status line, then the open pull-down on top. The caller presents
// once afterwards.
procedure draw_all();
begin
  st := syslib.fill_rect(rect.x, rect.y, ContentW, ContentH, white);
  st := stdlib.ui_menu_bar(rect.x, rect.y, ContentW, titles, 1, open_menu);
  draw_path_line();
  draw_lines();
  st := stdlib.ui_scrollbar(
    scroll_x, scroll_y, ScrollW, ScrollH, top_line, Rows, line_count(text), false);
  draw_status();
  if open_menu >= 0 then
    draw_dropdown();
end;

procedure present_frame();
begin
  st := syslib.window_present(id);
end;

// ---- shared checks -------------------------------------------------------

// Loads `child`, checks the chunked read and size agreement, then proves that
// every error class leaves the document intact.
procedure file_checks();
var
  keep_length: int;
  size: uint;
  value: Status;
begin
  value := open_path("base/child");
  verify("open child",
    value = Ok and path = "base/child" and int(core.len(text)) > 0);
  verify("child prefix", stdlib.starts_with(text, "unit child;"));
  keep_length := int(core.len(text));
  value := core.fs_size("base/child", size);
  verify("child size", value = Ok and int(core.len(text)) = int(size));
  verify("child lines", line_count(text) > 5);

  value := open_path("no_such_file");
  verify("missing file",
    value = NotFound and int(core.len(text)) = keep_length);
  value := open_path(".");
  verify("directory", value = Invalid and int(core.len(text)) = keep_length);
  value := open_path("base/child/x");
  verify("file as directory",
    value = Invalid and int(core.len(text)) = keep_length);
  value := open_path("base/widgets");
  verify("too large",
    value = CapacityExceeded and int(core.len(text)) = keep_length);
  verify("child intact", stdlib.starts_with(text, "unit child;"));
end;

// Line geometry, app-local editing (insert, delete, backspace, Enter, a 2-byte
// code point), the capacity boundary and invalid UTF-8.
procedure buffer_checks();
var
  i: int;
  value: Status;
begin
  text := "alpha\nbeta\ngamma";
  refresh_line_states();
  verify("line count", line_count(text) = 3);
  verify("line starts",
    line_start_of(text, 0) = 0 and line_start_of(text, 1) = 6
      and line_start_of(text, 2) = 11 and line_start_of(text, 3) = 16);
  verify("line ends",
    line_end_of(text, 0) = 5 and line_end_of(text, 6) = 10
      and line_end_of(text, 11) = 16);
  verify("line of pos",
    line_of_pos(text, 0) = 0 and line_of_pos(text, 6) = 1
      and line_of_pos(text, 16) = 2);
  verify("column", column_of(text, 0, 5) = 5 and column_of(text, 6, 10) = 4);

  collapse_to(0);
  replace_selection("X");
  verify("insert char",
    int(core.len(text)) = 17 and text[0] = byte(88) and caret = 1);
  delete_selection_or_backspace();
  verify("backspace char",
    text = "alpha\nbeta\ngamma" and caret = 0);

  move_vertical(1, false);
  verify("vertical down", caret = 6);
  move_vertical(1, false);
  verify("vertical down again", caret = 11);
  line_end_move(false, false);
  verify("end of line", caret = 16);
  replace_selection("\n");
  verify("enter splits", int(core.len(text)) = 17 and line_count(text) = 4);
  delete_selection_or_backspace();
  verify("backspace joins", int(core.len(text)) = 16 and line_count(text) = 3);
  line_home(false, false);
  verify("home line", caret = 11);
  line_end_move(false, true);
  verify("file end", caret = 16);

  text := "héllo";
  refresh_line_states();
  verify("multibyte length", int(core.len(text)) = 6);
  verify("boundary start",
    stdlib.str_boundary(text, 0) and stdlib.str_boundary(text, 1));
  verify("boundary inside", not stdlib.str_boundary(text, 2));
  verify("boundary after", stdlib.str_boundary(text, 3));
  collapse_to(3);
  value := ed_backspace(text, caret);
  anchor := caret;
  verify("backspace code point",
    value = Ok and text = "hllo" and caret = 1);
  scratch_bytes[0] := byte(0xC3);
  scratch_bytes[1] := byte(0xA9);
  copied := core.substr_into(scratch_text, scratch_bytes, 0, 2);
  verify("code point staged", copied = 2 and int(core.len(scratch_text)) = 2);
  replace_selection(scratch_text);
  verify("insert code point",
    int(core.len(text)) = 6 and text = "héllo" and caret = 3);
  collapse_to(3);
  verify("cursor left codepoint",
    stdlib.str_cursor_left(text, caret) = 1);
  verify("cursor right codepoint",
    stdlib.str_cursor_right(text, caret) = 3);

  i := 0;
  while i < BufferCapacity do
  begin
    load_stage[i] := byte(97);
    i := i + 1;
  end;
  value := publish_staged(BufferCapacity);
  verify("full buffer",
    value = Ok and int(core.len(text)) = BufferCapacity);
  value := ed_replace(text, 0, 0, "x");
  verify("capacity refused", value = CapacityExceeded);
  verify("capacity intact",
    int(core.len(text)) = BufferCapacity and text[0] = byte(97));

  text := "keep";
  refresh_line_states();
  load_stage[0] := byte(0xC3);
  load_stage[1] := byte(0x28);
  value := publish_staged(2);
  verify("invalid utf8", value = Invalid);
  verify("invalid kept", text = "keep");
end;

// The M6.3 save proof (spec 0019, E1): edit `base/child` and save it as the
// home copy, read it back and compare, then save again over the same path. A
// missing home disk reports the error and leaves the document and path alone.
procedure save_checks();
var
  value: Status;
  length: int;
begin
  value := open_path("base/child");
  verify("save open", value = Ok and path = "base/child");
  line_end_move(false, true);
  replace_selection("\n// saved by the M6.3 check\n");
  length := int(core.len(text));

  try_save();
  if no_home then
  begin
    verify("save no home", status_line = "no writable home");
    verify("save keeps document",
      int(core.len(text)) = length and path = "base/child");
  end
  else
  begin
    verify("save copied",
      status_line = "saved home/child" and path = "home/child");
    verify("saved contents", saved_matches());

    // The second save takes the sibling temporary path over the same target.
    length := int(core.len(text));
    try_save();
    verify("replace saved", status_line = "saved" and path = "home/child");
    verify("replace contents", saved_matches());
    verify("replace kept size", int(core.len(text)) = length);
  end;

  // Leave a normal document for the drawing probes.
  value := open_path("base/child");
  verify("save restore", value = Ok and path = "base/child");
end;

// Vertical scrolling on `base/child` (28 lines in 26 rows) and horizontal scrolling
// on a 100-byte line.
procedure scroll_checks();
var
  total: int;
  i: int;
  value: Status;
begin
  total := line_count(text);
  verify("child scrollable", total > Rows);
  caret := int(core.len(text));
  anchor := caret;
  ensure_visible();
  verify("view follows caret", top_line = total - Rows);

  move_vertical(0 - Rows, false);
  verify("page up caret", line_of_pos(text, caret) < total - 1);
  verify("page up view", top_line >= 0 and top_line <= total - Rows);

  line_home(false, true);
  verify("home top", caret = 0 and top_line = 0);

  i := 0;
  while i < 100 do
  begin
    load_stage[i] := byte(97);
    i := i + 1;
  end;
  value := publish_staged(100);
  verify("long line", value = Ok and int(core.len(text)) = 100);
  caret := int(core.len(text));
  anchor := caret;
  ensure_visible();
  verify("horizontal scroll",
    left_byte > 0 and caret - left_byte <= VisibleCols);
  verify("horizontal boundary", stdlib.str_boundary(text, left_byte));
  line_home(false, true);
  verify("horizontal reset", caret = 0 and left_byte = 0);
end;

// Drop queued events and any coalesced owner expose.
procedure drain_quiet();
var
  i: int;
begin
  i := 0;
  while i < 8 do
  begin
    st := syslib.poll_event(ev);
    if st <> Ok then
      i := 8
    else
      i := i + 1;
  end;
end;

// ---- injection (the deterministic test hook) ------------------------------

// Drains queued pointer events through the same handler the interactive loop
// uses. The redraw result is ignored because check mode draws explicitly; an
// owner `Expose` still refreshes the cached absolute layout.
procedure pump_pointer_events();
var
  active: bool;
  count: int;
begin
  active := true;
  count := 0;
  while active and count < 64 do
  begin
    st := syslib.poll_event(ev);
    if st = Ok then
    begin
      count := count + 1;
      if ev.kind = Expose then
      begin
        if ev.window = id then
          refresh_layout();
      end
      else if ev.window = id then
      begin
        if ev.kind = PointerDown or ev.kind = PointerUp or
           ev.kind = PointerMove then
          handle_pointer();
      end;
    end
    else
      active := false;
  end;
end;

procedure pointer_to(px: int; py: int);
begin
  st := inject.pointer_to(px, py);
  pump_pointer_events();
end;

procedure pointer_down();
begin
  st := inject.pointer_down();
  pump_pointer_events();
end;

procedure pointer_up();
begin
  st := inject.pointer_up();
  pump_pointer_events();
end;

// Moves with the primary button held. `inject.pointer_to` would release the
// button, so the delta goes directly through the debug pointer hook (M9.2).
procedure pointer_drag_to(px: int; py: int);
begin
  st := syslib.inject_pointer(
    px - syslib.pointer_x(), py - syslib.pointer_y(), uint(1));
  pump_pointer_events();
end;

// ---- modes ---------------------------------------------------------------

// The disabled-screen path: the same file, editing and view logic without a
// window or a pixel.
procedure host_path();
begin
  file_checks();
  scroll_checks();
  buffer_checks();
  save_checks();
  if failed then
    out.say("editor: host failed\n")
  else
    out.say("editor: host ok\n");
end;

procedure check_mode();
var
  i: int;
  found: bool;
  a: int;
  b: int;
  value: Status;
  total: int;
  thumb_y: int;
  thumb_h: int;
  travel: int;
begin
  file_checks();
  scroll_checks();
  buffer_checks();
  save_checks();

  // M9.1: source paths start highlighted, plain text files do not, and the
  // File > Highlight row is present and checked.
  value := open_path("home/readme.txt");
  verify("plain file plain", value = Ok and not highlight);
  verify("plain menu clear", not stdlib.ui_menu_has(file_checked, FileHighlightItem));
  value := open_path("base/child");
  verify("source file highlighted", value = Ok and highlight);
  verify("highlight item", file_items[FileHighlightItem] = "Highlight");
  verify("highlight checked", stdlib.ui_menu_has(file_checked, FileHighlightItem));

  // Lexical colours on deterministic source lines: keyword, comment, type,
  // number and string; then a block comment that starts on one line and ends
  // on the next.
  text := "unit child; // note\nvar n: int; const k := 1;\nconst s := \"x\";";
  refresh_line_states();
  highlight := true;
  file_checked := stdlib.ui_menu_set(file_checked, FileHighlightItem, true);
  collapse_to(int(core.len(text)));
  top_line := 0;
  left_byte := 0;
  draw_all();
  present_frame();
  verify("syntax keyword",
    region_has_color(text_x, text_y + 4, 320, 8, kw_color));
  verify("syntax comment",
    region_has_color(text_x, text_y + 4, 320, 8, comment_color));
  verify("syntax type",
    region_has_color(text_x, text_y + 4 + LineH, 320, 8, type_color));
  verify("syntax number",
    region_has_color(text_x, text_y + 4 + LineH, 320, 8, number_color));
  verify("syntax string",
    region_has_color(text_x, text_y + 4 + 2 * LineH, 320, 8, string_color));

  text := "unit c; { note\nstill note } var n: int;";
  refresh_line_states();
  collapse_to(int(core.len(text)));
  top_line := 0;
  left_byte := 0;
  draw_all();
  present_frame();
  verify("block comment continues",
    region_has_color(text_x, text_y + 4 + LineH, 320, 8, comment_color));
  verify("block comment ends",
    region_has_color(text_x, text_y + 4 + LineH, 320, 8, type_color));

  // The state at the first visible line must be computed line by line: the
  // earlier `//` ends at its newline and does not swallow the `{` on line 1.
  text := "// lead\n{ note\nstill note } var n: int;";
  refresh_line_states();
  collapse_to(int(core.len(text)));
  top_line := 2;
  left_byte := 0;
  draw_all();
  present_frame();
  verify("scrolled block comment",
    region_has_color(text_x, text_y + 4, 320, 8, comment_color));
  verify("scrolled block ends",
    region_has_color(text_x, text_y + 4, 320, 8, type_color));

  // The toggle off leaves only black/white/accent in the text area and clears
  // the menu check. Use the same three coloured lines as the on-probes.
  text := "unit child; // note\nvar n: int; const k := 1;\nconst s := \"x\";";
  refresh_line_states();
  collapse_to(int(core.len(text)));
  top_line := 0;
  left_byte := 0;
  highlight := false;
  file_checked := stdlib.ui_menu_set(file_checked, FileHighlightItem, false);
  draw_all();
  present_frame();
  verify("off keyword",
    not region_has_color(text_x, text_y + 4, 320, 8, kw_color));
  verify("off comment",
    not region_has_color(text_x, text_y + 4 + LineH, 320, 8, comment_color));
  verify("off type",
    not region_has_color(text_x, text_y + 4 + LineH, 320, 8, type_color));
  verify("off string",
    not region_has_color(text_x, text_y + 4 + 2 * LineH, 320, 8, string_color));
  verify("highlight menu off", not stdlib.ui_menu_has(file_checked, FileHighlightItem));
  highlight := true;
  file_checked := stdlib.ui_menu_set(file_checked, FileHighlightItem, true);

  // A deterministic document for the drawing probes.
  text := "IGIS editor\nline two\nline three";
  refresh_line_states();
  status_line := "check mode";
  collapse_to(0);
  top_line := 0;
  left_byte := 0;
  draw_all();
  present_frame();

  verify("menu rule", syslib.get_pixel(rect.x + 300, rect.y + 21) = black);
  verify("path rule", syslib.get_pixel(rect.x + 300, rect.y + 37) = black);
  verify("glyph ink", syslib.get_pixel(text_x + 1, text_y + 4) = black);
  verify("glyph hole", syslib.get_pixel(text_x + 4, text_y + 5) = white);
  verify("caret", syslib.get_pixel(text_x, text_y + 8) = black);

  anchor := 0;
  caret := 2;
  draw_all();
  present_frame();
  verify("selection band", syslib.get_pixel(text_x + 8, text_y + 2) = accent);
  collapse_to(0);
  draw_all();
  present_frame();

  verify("scrollbar border", syslib.get_pixel(scroll_x, scroll_y) = black);
  verify("scrollbar thumb", syslib.get_pixel(scroll_x + 4, scroll_y + 3) = gray);
  verify("status rule", syslib.get_pixel(rect.x + 300, status_y - 2) = black);

  // One injected key event proves the queue/routing path: it must arrive with
  // this window's id and flow through handle_key.
  drain_quiet();
  ev.kind := KeyDown;
  ev.x := 0;
  ev.y := 0;
  ev.code := uint(0x58 + 0x58 * 65536);
  ev.window := 0;
  st := syslib.inject_event(ev);
  verify("event injected", st = Ok);
  found := false;
  i := 0;
  while i < 8 and not found do
  begin
    st := syslib.poll_event(ev);
    if st = Ok then
    begin
      if ev.kind = Expose then
      begin
        if ev.window = id then
        begin
          refresh_layout();
          draw_all();
          present_frame();
        end;
      end
      else if ev.kind = KeyDown then
      begin
        verify("event routed", ev.window = id);
        handle_key();
        found := true;
      end;
    end
    else
      i := 8;
    i := i + 1;
  end;
  verify("event handled", found);
  verify("event text", stdlib.starts_with(text, "XIGIS"));
  delete_selection_or_backspace();
  verify("event undone", stdlib.starts_with(text, "IGIS"));

  // M9.2: the scrollbar thumb drags through the real pointer path, matching the
  // browser's M8.9. `base/child` has more lines than the 26-row view.
  value := open_path("base/child");
  verify("drag open", value = Ok and highlight);
  top_line := 0;
  left_byte := 0;
  caret := 0;
  anchor := 0;
  draw_all();
  present_frame();
  total := line_count(text);
  verify("drag scrollable", total > Rows);
  scrollbar_thumb(thumb_y, thumb_h);
  verify("drag starts on thumb",
    stdlib.ui_scrollbar_hit(
      scroll_x, scroll_y, ScrollW, ScrollH,
      scroll_x + 8, thumb_y + thumb_h div 2,
      top_line, Rows, total) = 3);
  pointer_to(scroll_x + 8, thumb_y + thumb_h div 2);
  pointer_down();
  verify("drag grabs thumb", scroll_dragging);
  pointer_drag_to(scroll_x + 8, scroll_y + ScrollH - 4);
  verify("scrollbar drag down", top_line = total - Rows);
  pointer_up();
  verify("scrollbar drag ends",
    not scroll_dragging and top_line = total - Rows);
  draw_all();
  present_frame();
  scrollbar_thumb(thumb_y, thumb_h);
  travel := (ScrollH - 4) - thumb_h;
  verify("scrollbar thumb moved",
    travel > 0 and syslib.get_pixel(scroll_x + 4, thumb_y + 2) = gray);

  st := syslib.window_close(id);
  if failed then
    out.say("editor: failed\n")
  else
    out.say("editor: ok\n");
end;

procedure interactive_mode();
begin
  st := open_path(path);
  draw_all();
  present_frame();
  running := true;
  while running do
  begin
    st := syslib.next_event(ev);
    if st <> Ok then
      running := false
    else if ev.kind = Expose then
    begin
      if ev.window = id then
      begin
        refresh_layout();
        draw_all();
        present_frame();
      end;
    end
    else if ev.kind = Close then
    begin
      // The close box requests a close; only this window goes (spec 0011,
      // W23). The loop then closes it and returns.
      if ev.window = id then
        running := false;
    end
    else if ev.kind = KeyDown then
    begin
      if ev.window = id then
      begin
        handle_key();
        if running then
        begin
          draw_all();
          present_frame();
        end;
      end;
    end
    else if ev.kind = PointerDown or ev.kind = PointerUp or ev.kind = PointerMove then
    begin
      if ev.window = id then
      begin
        // M9.2: only a pointer event that changed visible state repaints.
        if handle_pointer() and running then
        begin
          draw_all();
          present_frame();
        end;
      end;
    end;
  end;
  st := syslib.window_close(id);
end;

procedure shot_mode();
var
  deadline: uint;
  dirty: bool;
  i: int;
begin
  st := open_path(path);
  draw_all();
  present_frame();
  out.say("editor: ready\n");
  deadline := core.clock() + uint(HoldSeconds) * uint(NanosPerSecond);
  while core.clock() < deadline and running do
  begin
    dirty := false;
    i := 0;
    while i < 16 do
    begin
      st := syslib.poll_event(ev);
      if st <> Ok then
        i := 16
      else
      begin
        i := i + 1;
        if ev.kind = Expose then
        begin
          if ev.window = id then
          begin
            refresh_layout();
            dirty := true;
          end;
        end
        else if ev.kind = KeyDown then
        begin
          if ev.window = id then
          begin
            handle_key();
            dirty := true;
          end;
        end
        else if ev.kind = PointerDown or ev.kind = PointerUp
                or ev.kind = PointerMove then
        begin
          if ev.window = id then
          begin
            if handle_pointer() then
              dirty := true;
          end;
        end;
        if not running then
          i := 16;
      end;
    end;
    if dirty then
    begin
      draw_all();
      present_frame();
    end;
  end;
  st := syslib.window_close(id);
  out.say("editor: done\n");
end;

procedure parse_args(args: const string[1024]);
var
  space: int;
  trimmed: string[256];
  got: int;
begin
  mode := 0;
  path := "base/child";
  if stdlib.starts_with(args, "check") then
    mode := 1
  else if stdlib.starts_with(args, "shot") then
  begin
    mode := 2;
    space := core.find(args, byte(32));
    if space >= 0 and space + 1 < int(core.len(args)) then
    begin
      used := core.substr_into(
        tail_buf, args, space + 1, int(core.len(args)) - space - 1);
      got := stdlib.trim_into(trimmed, tail_buf);
      if got > 0 and got <= PathCapacity then
        used := core.substr_into(path, trimmed, 0, got)
      else if got > PathCapacity then
        status_line := "path too long";
    end;
  end
  else if int(core.len(args)) > 0 then
  begin
    used := core.substr_into(tail_buf, args, 0, int(core.len(args)));
    got := stdlib.trim_into(trimmed, tail_buf);
    if got > 0 and got <= PathCapacity then
      used := core.substr_into(path, trimmed, 0, got)
    else if got > PathCapacity then
      status_line := "path too long";
  end;
end;

procedure main(args: const string[1024]);
var
  screen_w: uint;
  screen_h: uint;
begin
  failed := false;
  step := 0;
  running := true;
  open_menu := -1;
  selected := -1;
  caret := 0;
  anchor := 0;
  top_line := 0;
  left_byte := 0;
  text := "";
  refresh_line_states();
  status_line := "";
  black := stdlib.ui_black();
  white := stdlib.ui_white();
  gray := stdlib.ui_gray();
  accent := stdlib.ui_accent();
  // M9.1 palette: keyword blue, type dark red, string dark green, comment
  // medium gray, number dark brown. Selected text stays white on the accent.
  kw_color := uint(0x000080);
  type_color := uint(0x800000);
  string_color := uint(0x008000);
  comment_color := uint(0x808080);
  number_color := uint(0x804000);
  highlight := true;
  block_open := false;
  file_checked := uint(0);
  setup_highlight();
  setup_menu();
  parse_args(args);

  screen_w := syslib.screen_width();
  screen_h := syslib.screen_height();
  if screen_w = uint(0) then
    host_path()
  else if screen_w < uint(WindowX + ContentW + 40) or
          screen_h < uint(WindowY + ContentH + 60) then
    out.say("editor: screen too small\n")
  else
  begin
    st := syslib.window_open(WindowX, WindowY, ContentW, ContentH, "Editor", id);
    if st <> Ok then
      out.say("editor: no window\n")
    else
    begin
      st := syslib.window_content_rect(id, rect);
      if st <> Ok then
        out.say("editor: no content rect\n")
      else
      begin
        compute_layout();
        if mode = 1 then
          check_mode()
        else if mode = 2 then
          shot_mode()
        else
          interactive_mode();
      end;
    end;
  end;
end;
