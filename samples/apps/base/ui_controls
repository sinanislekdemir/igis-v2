unit ui_controls;

// M2.4.2 proof: the stdlib controls layer in a real window.
//
//   run ui_controls
//
// The app opens a window, draws a button, a checkbox, a text field, a vertical
// scrollbar and a list, then drives them with injected pointer and key events:
//
//   1. A pointer press on the button paints the pressed (gray) face and a
//      release inside activates it (`ui_button_pressed`).
//   2. A pointer click toggles the checkbox (`ui_checkbox_toggle`), and the
//      check mark and the focused ring are checked with `get_pixel`.
//   3. Tab moves the focus; typed text, Backspace, Delete and the arrows edit
//      the text field through the M2.4.1 helpers, driven by the key decode
//      helpers. The caret, the accent selection band and the visible slice are
//      checked with `get_pixel`.
//   4. A click below the scrollbar thumb pages down; the thumb moves and the
//      focused ring appears.
//   5. Up/Down moves the list selection and `ui_list_ensure_visible` scrolls
//      the list; a row click selects through `ui_list_hit`.
//   6. Tab wraps the focus back to the button.
//
// The first failing check is printed with its step number. `langhost` and a
// kernel without a framebuffer run the pure helpers and the disabled-screen
// `Invalid` contract and print `ui_controls: host ok`.

uses core, stdlib, syslib;

const
  ControlCount = 5;
  ButtonW = 120;
  ButtonH = 24;
  FieldW = 320;
  FieldH = 22;
  ListW = 320;
  ListH = 82;
  ScrollW = 16;
  ScrollH = 160;
  Gap = 20;

var
  failed: bool;
  fail_step: int;
  fail_label: string[64];
  step: int;
  status: Status;
  present_status: Status;
  screen_w: uint;
  screen_h: uint;
  id: int;
  rect: Rect;
  ev: Event;
  flushed: uint;

  bx: int;
  by: int;
  cx: int;
  cy: int;
  tx: int;
  ty: int;
  sx: int;
  sy: int;
  lx: int;
  ly: int;

  focus_index: int;
  button_clicks: int;
  button_down: bool;
  checkbox_down: bool;
  checked: bool;

  field_text: string[256];
  field_cursor: int;
  field_scroll: int;
  sel_start: int;
  sel_stop: int;
  one: bytes[1];
  ch: string[1];
  digits: string[16];
  copied: int;

  scroll_position: int;
  scroll_visible: int;
  scroll_total: int;

  items: array[string[64], 8];
  list_count: int;
  list_selected: int;
  list_top: int;

  black: uint;
  white: uint;
  gray: uint;
  accent: uint;

  dirty: bool;
  shot: bool;
  hit_row: int;
  command: int;
  at: int;

procedure say(line: const string[0]);
begin
  core.write(line);
end;

procedure verify(label: const string[0]; passed: bool);
begin
  step := step + 1;
  if not passed and not failed then
  begin
    failed := true;
    fail_step := step;
    fail_label := label;
  end;
end;

// ---- pure helpers and the disabled-screen contract ---------------------

procedure pure_checks();
begin
  verify("rect hit origin", stdlib.ui_rect_hit(10, 10, 10, 10, 10, 10));
  verify("rect hit inside", stdlib.ui_rect_hit(10, 10, 10, 10, 19, 19));
  verify("rect hit past x", not stdlib.ui_rect_hit(10, 10, 10, 10, 20, 15));
  verify("rect hit past y", not stdlib.ui_rect_hit(10, 10, 10, 10, 15, 20));
  verify("rect hit before", not stdlib.ui_rect_hit(10, 10, 10, 10, 9, 9));
  verify("rect hit empty", not stdlib.ui_rect_hit(0, 0, 0, 10, 0, 0));

  verify("button hit", stdlib.ui_button_hit(0, 0, 20, 20, 10, 10));
  verify("button hit border", not stdlib.ui_button_hit(0, 0, 20, 20, 20, 10));
  verify("checkbox hit", stdlib.ui_checkbox_hit(0, 0, 10, 10));
  verify("checkbox hit label is not a hit", not stdlib.ui_checkbox_hit(0, 0, 20, 5));

  verify("button pressed inside", stdlib.ui_button_pressed(true, true));
  verify("button released outside", not stdlib.ui_button_pressed(true, false));
  verify("button release when up", not stdlib.ui_button_pressed(false, true));
  verify("checkbox toggle on", stdlib.ui_checkbox_toggle(false));
  verify("checkbox toggle off", not stdlib.ui_checkbox_toggle(true));

  verify("focus next forward", stdlib.ui_focus_next(0, 5, 1) = 1);
  verify("focus next wrap", stdlib.ui_focus_next(4, 5, 1) = 0);
  verify("focus next back wrap", stdlib.ui_focus_next(0, 5, -1) = 4);
  verify("focus next empty", stdlib.ui_focus_next(3, 0, 1) = 0);
  verify("focus next stale", stdlib.ui_focus_next(7, 5, 1) = 3);

  verify("list rows", stdlib.ui_list_rows(82) = 5 and stdlib.ui_list_rows(1) = 0);
  verify("list move down", stdlib.ui_list_move(2, 6, 1) = 3);
  verify("list move clamp top", stdlib.ui_list_move(0, 6, -1) = 0);
  verify("list move clamp end", stdlib.ui_list_move(5, 6, 1) = 5);
  verify("list move empty", stdlib.ui_list_move(4, 0, 1) = 0);
  verify("list ensure below", stdlib.ui_list_ensure_visible(5, 0, 5) = 1);
  verify("list ensure above", stdlib.ui_list_ensure_visible(1, 3, 5) = 1);
  verify("list ensure visible", stdlib.ui_list_ensure_visible(2, 0, 5) = 0);
  verify("list hit row", stdlib.ui_list_hit(0, 0, 100, 82, 10, 21, 6, 0) = 1);
  verify("list hit border", stdlib.ui_list_hit(0, 0, 100, 82, 10, 0, 6, 0) = -1);
  verify("list hit past items", stdlib.ui_list_hit(0, 0, 100, 82, 10, 70, 2, 0) = -1);
  verify("list hit offset", stdlib.ui_list_hit(0, 0, 100, 82, 10, 21, 6, 1) = 2);

  verify("scroll clamp low", stdlib.ui_scrollbar_clamp(-3, 10, 100) = 0);
  verify("scroll clamp high", stdlib.ui_scrollbar_clamp(200, 10, 100) = 90);
  verify("scroll clamp empty", stdlib.ui_scrollbar_clamp(5, 10, 5) = 0);
  verify(
    "scroll hit thumb",
    stdlib.ui_scrollbar_hit(0, 0, 16, 160, 8, 5, 0, 10, 100) = 3);
  verify(
    "scroll hit below",
    stdlib.ui_scrollbar_hit(0, 0, 16, 160, 8, 150, 0, 10, 100) = 2);
  verify(
    "scroll hit outside",
    stdlib.ui_scrollbar_hit(0, 0, 16, 160, 30, 5, 0, 10, 100) = 0);

  verify("key text", stdlib.ui_key_text(uint(72 * 65536 + 104)) = byte(104));
  verify("key modifiers", stdlib.ui_key_modifiers(uint(65 + 1 * 256)) = 1);
  verify("key code", stdlib.ui_key_code(uint(72 * 65536 + 104)) = 72);
  verify("key backspace", stdlib.ui_key_is_backspace(uint(0x101 * 65536)));
  verify("key tab", stdlib.ui_key_is_tab(uint(0x102 * 65536)));
  verify("key enter", stdlib.ui_key_is_enter(uint(0x103 * 65536)));
  verify("key left", stdlib.ui_key_is_left(uint(0x110 * 65536)));
  verify("key right", stdlib.ui_key_is_right(uint(0x111 * 65536)));
  verify("key up", stdlib.ui_key_is_up(uint(0x112 * 65536)));
  verify("key down", stdlib.ui_key_is_down(uint(0x113 * 65536)));
  verify("key home", stdlib.ui_key_is_home(uint(0x114 * 65536)));
  verify("key end", stdlib.ui_key_is_end(uint(0x115 * 65536)));
  verify("key delete", stdlib.ui_key_is_delete(uint(0x119 * 65536)));
  verify("key non-text", not stdlib.ui_key_is_tab(uint(72 * 65536 + 104)));

  field_text := "abcdef";
  verify(
    "field reveal keeps visible",
    stdlib.ui_text_field_reveal(field_text, 2, 0, 24) = 0);
  verify(
    "field reveal scrolls right",
    stdlib.ui_text_field_reveal(field_text, 6, 0, 24) = 3);
  verify(
    "field reveal scrolls left",
