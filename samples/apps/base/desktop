unit desktop;

// M2.1 graphics demo: a Mac OS System 7.5-style desktop drawn through `syslib`
// and verified with `syslib.get_pixel` before it prints `desktop: ok`.
//
// All rasterisation happens in the kernel: the interpreted part is a fixed
// sequence of a few dozen calls, not a per-pixel loop (spec 0009, G18).
//
//   run desktop
//
// The screen geometry comes from `syslib.screen_width()`/`screen_height()`, so
// the background, the menu bar and the right-aligned clock follow the mode the
// bootloader actually returned. The one window has a fixed size and is simply
// clipped on a smaller screen.

uses core, syslib;

const
  WX = 120;         // window origin
  WY = 80;
  WW = 480;         // window size
  WH = 300;
  TitleBar = 22;

var
  white: uint;
  black: uint;
  w: uint;
  h: uint;
  ok: bool;
  status: Status;
  clk_h: string[2];
  clk_m: string[2];
  wide: string[16];
  high: string[16];
  used: int;
  now: uint;
  minutes: uint;
  hours: uint;
  y: int;
  clock_x: int;

procedure say(line: const string[0]);
begin
  core.write(line);
end;

// Checks one expected pixel. Only the first mismatch is reported, so the
// output names the first thing that is wrong.
procedure check(x: int; y: int; want: uint; label: const string[0]);
var
  got: uint;
begin
  if ok then
  begin
    got := syslib.get_pixel(x, y);
    if got <> want then
    begin
      ok := false;
      say("desktop: FAIL ");
      say(label);
      say("\n");
    end;
  end;
end;

// HH:MM from the monotonic clock, right-aligned in the menu bar.
procedure draw_clock(right: int);
begin
  now := core.clock();
  minutes := (now div uint(1000000000)) div uint(60);
  hours := (minutes div uint(60)) mod uint(24);
  minutes := minutes mod uint(60);
  used := core.format_int_into(clk_h, int(hours), uint(10), uint(2));
  used := core.format_int_into(clk_m, int(minutes), uint(10), uint(2));
  clock_x := right - 40;
  if clock_x > 200 then
  begin
    status := syslib.draw_text(clock_x, 7, clk_h, black);
    status := syslib.draw_text(clock_x + 16, 7, ":", black);
    status := syslib.draw_text(clock_x + 24, 7, clk_m, black);
  end;
end;

procedure draw_menu_bar();
var
  width: int;
begin
  width := int(w);
  status := syslib.fill_rect(0, 0, width, 22, white);
  // The Apple position is a solid square in this slice.
  status := syslib.fill_rect(8, 7, 8, 8, black);
  status := syslib.draw_text(24, 7, "File", black);
  status := syslib.draw_text(64, 7, "Edit", black);
  status := syslib.draw_text(104, 7, "View", black);
  status := syslib.draw_text(152, 7, "Special", black);
  status := syslib.fill_rect(0, 21, width, 1, black);
  draw_clock(width - 8);
end;

procedure draw_window();
var
  title_x: int;
begin
  // Content first, then the frame, so the one-pixel border stays on top.
  status := syslib.fill_rect(
    WX + 1, WY + TitleBar, WW - 2, WH - TitleBar - 1, white);
  status := syslib.draw_rect(WX, WY, WW, WH, black);

  // Title bar: white, horizontal stripes, a close box and a white title band.
  status := syslib.fill_rect(WX + 1, WY + 1, WW - 2, TitleBar, white);
  y := WY + 3;
  while y < WY + TitleBar do
  begin
    status := syslib.fill_rect(WX + 2, y, WW - 4, 1, black);
    y := y + 2;
  end;
  status := syslib.fill_rect(WX + 6, WY + 6, 11, 11, white);
  status := syslib.draw_rect(WX + 6, WY + 6, 11, 11, black);
  title_x := WX + (WW - 56) div 2;
  status := syslib.fill_rect(title_x - 4, WY + 5, 64, 12, white);
  status := syslib.draw_text(title_x, WY + 7, "igis-v2", black);

  // Three content lines, all through the 8x8 font.
  status := syslib.draw_text(WX + 16, WY + 40, "Hello from igis-v2", black);
  used := core.format_int_into(wide, int(w), uint(10), uint(0));
  used := core.format_int_into(high, int(h), uint(10), uint(0));
  status := syslib.draw_text(WX + 16, WY + 56, "screen", black);
  status := syslib.draw_text(WX + 72, WY + 56, wide, black);
  status := syslib.draw_text(WX + 112, WY + 56, "x", black);
  status := syslib.draw_text(WX + 120, WY + 56, high, black);
  status := syslib.draw_text(WX + 156, WY + 56, "x 32bpp", black);
  status := syslib.draw_text(WX + 16, WY + 72, "M2.1: shadow + present", black);
end;

procedure main(args: const string[1024]);
begin
  white := uint(0xFFFFFF);
  black := uint(0x000000);
  ok := true;

  w := syslib.screen_width();
  h := syslib.screen_height();

  // A white screen first (this also exercises `syslib.clear`), then the 50%
  // dither that gives the classic grey desktop.
  status := syslib.clear(white);
  status := syslib.fill_dither(0, 0, int(w), int(h), black);

  draw_menu_bar();
  draw_window();

  // One-pixel black border at the screen edge, drawn last so the menu bar does
  // not paint over it.
  status := syslib.draw_rect(0, 0, int(w), int(h), black);
  status := syslib.present(0, 0, int(w), int(h));

  // Self-check: the first mismatch is reported, otherwise nothing but `ok`.
  check(4, 40, black, "desktop background");
  check(5, 40, white, "desktop dither gap");
  check(700, 2, white, "menu bar");
  check(700, 21, black, "menu baseline");
  check(WX + 100, WY, black, "window frame");
  check(400, WY + 3, black, "title stripe");
  check(400, WY + 4, white, "title gap");
  check(WX + 40, WY + 100, white, "window content");
  check(WX + 6, WY + 6, black, "close box");

  if ok then
    say("desktop: ok\n");
end;
