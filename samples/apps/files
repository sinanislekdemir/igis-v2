unit files;

// M2.5.1 proof app: the read-only application file API (spec 0013).
//
//   run files
//
// Lists the image root, then reads a known source (`child`) in fixed 256-byte
// chunks and checks the total against `core.fs_size`. It also proves the
// offset rules (a middle byte, the last byte, an offset at the end and past
// it), atomic failure (`dst` and `read` untouched), and the M2.5.1 limits:
// a missing name is `NotFound`, a directory or a subdirectory path is
// `Invalid`, and a non-root listing is `Invalid`. A destination smaller than
// 256 bytes is a compile error, so it cannot be exercised here; the compiler
// test covers it.

uses core;

var
  ok: bool;
  st: Status;
  index: uint;
  count: uint;
  name: string[64];
  kind: uint;
  size: uint;
  each_ok: bool;
  found_child: bool;
  found_text: bool;
  child_size: uint;
  total: uint;
  off: uint;
  got: int;
  first: int;
  chunk: bytes[256];
  prefix: string[16];
  digits: string[32];
  used: int;

procedure say(text: const string[0]);
begin
  core.write(text);
end;

procedure say_int(value: int);
begin
  used := core.format_int_into(digits, value, uint(10), uint(0));
  core.write(digits);
end;

// One line per step; the first failure names the step and stops the checks.
procedure check(label: const string[0]; passed: bool);
begin
  if ok then
  begin
    if passed then
    begin
      say("files: ");
      say(label);
      say(" ok\n");
    end
    else
    begin
      ok := false;
      say("files: FAIL ");
      say(label);
      say("\n");
    end;
  end;
end;

procedure list_root();
begin
  count := uint(0);
  each_ok := true;
  found_child := false;
  found_text := false;
  child_size := uint(0);
  index := uint(0);
  st := core.fs_list("", index, name, kind, size);
  while st = Ok do
  begin
    count := count + uint(1);
    if kind > uint(1) then
      each_ok := false;
    if kind = uint(0) and size = uint(0) then
      each_ok := false;
    if name = "child" then
    begin
      found_child := true;
      if kind = uint(0) then
        child_size := size
      else
        each_ok := false;
    end;
    if name = "text" then
      found_text := true;
    index := index + uint(1);
    st := core.fs_list("", index, name, kind, size);
  end;
  check("root listing", each_ok and st = NotFound and count > uint(0) and found_child and found_text);
  say("files: root entries=");
  say_int(int(count));
  say("\n");
end;

procedure read_child();
begin
  total := uint(0);
  off := uint(0);
  each_ok := true;
  while off < child_size and each_ok do
  begin
    st := core.fs_read("child", off, chunk, got);
    if st <> Ok or got < 0 then
      each_ok := false
    else if got = 0 then
      each_ok := false
    else
    begin
      if int(core.len(chunk)) <> got then
        each_ok := false;
      if off = uint(0) then
      begin
        first := core.substr_into(prefix, chunk, 0, 11);
        if first <> 11 or prefix <> "unit child;" then
          each_ok := false;
      end;
      total := total + uint(got);
      off := off + uint(got);
    end;
  end;
  check("chunked read", each_ok and total = child_size and off = child_size);
  say("files: read ");
  say_int(int(total));
  say("/");
  say_int(int(child_size));
  say("\n");
end;

procedure check_offsets();
begin
  each_ok := true;
  // Offset 1 starts on the second byte of "unit child;".
  got := -1;
  st := core.fs_read("child", uint(1), chunk, got);
  if st <> Ok or got <= 0 then
    each_ok := false
  else if chunk[0] <> byte(110) then
    each_ok := false;

  // The last byte is the file's trailing newline and returns exactly one byte.
  got := -1;
  st := core.fs_read("child", child_size - uint(1), chunk, got);
  if st <> Ok or got <> 1 or int(core.len(chunk)) <> 1 then
    each_ok := false
  else if chunk[0] <> byte(10) then
    each_ok := false;

  // At the end and past it the read is an Ok with zero bytes, not an error.
  got := -1;
  st := core.fs_read("child", child_size, chunk, got);
  if st <> Ok or got <> 0 or int(core.len(chunk)) <> 0 then
    each_ok := false;
  got := -1;
  st := core.fs_read("child", child_size + uint(256), chunk, got);
  if st <> Ok or got <> 0 then
    each_ok := false;
  check("offset rules", each_ok);
end;

procedure check_errors();
begin
  each_ok := true;

  // A missing name leaves the destination and the count untouched.
  chunk := "keep";
  got := -1;
  st := core.fs_read("no_such_app", uint(0), chunk, got);
  if st <> NotFound or chunk <> "keep" or got <> -1 then
    each_ok := false;

  // The root and a subdirectory path are not readable files in M2.5.1.
  chunk := "keep";
  got := -1;
  st := core.fs_read(".", uint(0), chunk, got);
  if st <> Invalid or chunk <> "keep" or got <> -1 then
    each_ok := false;
  st := core.fs_read("child/x", uint(0), chunk, got);
  if st <> Invalid then
    each_ok := false;

  // Listing is root-only: a name or a subdirectory path is unsupported.
  st := core.fs_list("child", uint(0), name, kind, size);
  if st <> Invalid then
    each_ok := false;

  // Size: a missing name is NotFound, a directory is Invalid.
  st := core.fs_size("no_such_app", size);
  if st <> NotFound then
    each_ok := false;
  st := core.fs_size(".", size);
  if st <> Invalid then
    each_ok := false;
  check("error paths", each_ok);
end;

procedure main(args: const string[1024]);
begin
  ok := true;

  list_root();
  check("root dot", core.fs_list(".", uint(0), name, kind, size) = Ok);
  check("size agrees", core.fs_size("child", size) = Ok and size = child_size and child_size > uint(0));
  read_child();
  check_offsets();
  check_errors();

  if ok then
    say("files: ok\n")
  else
    say("files: FAILED\n");
end;
