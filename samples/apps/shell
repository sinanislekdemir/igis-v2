unit shell;

uses core;

var
  banner: string[32];
  line: string[256];
  cmd: string[64];
  rest: string[256];
  path: string[256];
  argv: string[256];
  st: Status;
  id: int;
  code: int;
  space: int;
  split: int;
  done: bool;

procedure say(text: const string[0]);
begin
  core.write(text);
end;

// Reports the staged reason int from `core.wait`: `0` Ok, `1` Killed,
// `2 + fault_code` Faulted. `ExitReason` is not a language type yet (spec
// 0005), so the reason stays an `int` and this procedure decodes it.
procedure report(reason: int);
begin
  if reason = 0 then
    say("child: ok\n")
  else if reason = 1 then
    say("child: killed\n")
  else if reason >= 2 then
    say("child: faulted\n")
  else
    say("child: bad reason\n");
end;

procedure main(args: const string[1024]);
begin
  banner := "igis-v2 shell\n";
  say(banner);
  say("shell: spawning child\n");

  // `core.spawn` returns `Status` and writes the reserved task id through the
  // `var` out-parameter (spec 0003 E1, spec 0005). `core.wait` blocks until
  // the child exits and writes its reason int.
  st := core.spawn("child", "hello", id);
  if st = Ok then
  begin
    say("shell: child task id assigned\n");
    st := core.wait(id, code);
    if st = Ok then
      report(code)
    else
      say("child: wait failed\n");
  end
  else
  begin
    say("shell: spawn failed\n");
  end;

  // Command loop. Staged line discipline (spec 0005, Q44): the kernel echoes
  // the typed bytes and completes one line; `core.read_line` blocks until it
  // is ready. `core.find` locates the first space, and `core.substr_into`
  // splits the line into the command and its tail. With no space the whole
  // line is the command and a zero-length slice clears the tail.
  //
  // There is no `return` yet, so `main` ends by leaving the loop with `done`.
  done := false;
  while not done do
  begin
    say("shell> ");
    code := core.read_line(line);
    space := core.find(line, byte(32));
    if space < 0 then
    begin
      split := core.substr_into(cmd, line, 0, int(core.len(line)));
      split := core.substr_into(rest, line, int(core.len(line)), 0);
    end
    else
    begin
      split := core.substr_into(cmd, line, 0, space);
      split := core.substr_into(rest, line, space + 1, int(core.len(line)) - space - 1);
    end;

    if cmd = "help" then
      say("shell: help, echo <text>, run <app> [args], exit\n")
    else if cmd = "echo" then
    begin
      say(rest);
      say("\n");
    end
    else if cmd = "run" then
    begin
      // `rest` is `<app> [args]`; split its tail at the first space so the
      // kernel receives an unparsed application path and argument string.
      split := core.find(rest, byte(32));
      if split < 0 then
      begin
        split := core.substr_into(path, rest, 0, int(core.len(rest)));
        split := core.substr_into(argv, rest, int(core.len(rest)), 0);
      end
      else
      begin
        split := core.substr_into(path, rest, 0, split);
        split := core.substr_into(argv, rest, split + 1, int(core.len(rest)) - split - 1);
      end;

      if core.len(path) = uint(0) then
        say("usage: run <app> [args]\n")
      else
      begin
        st := core.spawn(path, argv, id);
        if st = Ok then
        begin
          say("started\n");
          st := core.wait(id, code);
          if st = Ok then
            report(code)
          else
            say("wait failed\n");
        end
        else
          say("spawn failed\n");
      end;
    end
    else if cmd = "exit" then
      done := true
    else
      say("unknown\n");
  end;

  say("bye\n");
end;
