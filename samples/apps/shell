unit shell;

uses core;

var
  banner: string[32];
  line: string[256];
  id: int;
  code: int;
  count: int;

procedure say(text: const string[0]);
begin
  core.write(text);
end;

procedure main(args: const string[1024]);
begin
  banner := "igis-v2 shell\n";
  say(banner);
  say("shell: spawning child\n");

  // Staged ABI: a positive result is a task id, a negative one is -Status.
  id := core.spawn("child", "hello");
  if id > 0 then
  begin
    say("shell: child task id assigned\n");

    // Blocks on the child; the scheduler runs it and wakes us on exit.
    code := core.wait(id);
    if code = 0 then
      say("child: ok\n")
    else if code = 1 then
      say("child: killed\n")
    else if code >= 2 then
      say("child: faulted\n")
    else
      say("child: wait failed\n");
  end
  else
  begin
    say("shell: spawn failed\n");
  end;

  // Staged line discipline (spec 0005, Q44): the kernel echoes the typed
  // bytes and completes one line; core.read_line blocks until it is ready.
  // The language cannot index a buffer yet, so the shell counts three lines
  // and echoes each one whole.
  count := 0;
  while count < 3 do
  begin
    say("shell> ");
    code := core.read_line(line);
    say("you said: ");
    say(line);
    say("\n");
    count := count + 1;
  end;

  say("bye\n");
end;
