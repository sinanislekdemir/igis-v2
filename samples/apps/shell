unit shell;

uses core;

var
  banner: string[32];
  n: int;
  round: int;

procedure say(text: const string[0]);
begin
  core.write(text);
end;

procedure main(args: const string[1024]);
begin
  banner := "igis-v2 shell\n";
  say(banner);
  say("argv: ");
  say(args);
  say("\n");

  // Four rounds of 50 000 iterations. This is enough work to cross many
  // 10 000-step quanta, so the scheduler claims, releases and re-claims the
  // boot task instead of running it from one call.
  round := 0;
  while round < 4 do
  begin
    n := 0;
    while n < 50000 do
    begin
      n := n + 1;
    end;
    round := round + 1;
    if round = 1 then
      say("shell: round 1 of 4\n")
    else if round = 2 then
      say("shell: round 2 of 4\n")
    else if round = 3 then
      say("shell: round 3 of 4\n")
    else
      say("shell: round 4 of 4\n");
  end;
  say("shell: done\n");
end;
