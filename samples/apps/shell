unit shell;

uses core;

var
  banner: string[32];
  line: string[256];
  id: int;
  code: int;
  done: bool;

procedure say(text: const string[0]);
begin
  core.write(text);
end;

procedure main(args: const string[1024]);
begin
  banner := "igis-v2 shell\n";
  say(banner);
  say("shell: spawning child\n");

  // Staged ABI: a positive result is a task id, a negative one is -Status.
  id := core.spawn("child", "hello");
  if id > 0 then
  begin
    say("shell: child task id assigned\n");

    // Blocks on the child; the scheduler runs it and wakes us on exit.
    code := core.wait(id);
    if code = 0 then
      say("child: ok\n")
    else if code = 1 then
      say("child: killed\n")
    else if code >= 2 then
      say("child: faulted\n")
    else
      say("child: wait failed\n");
  end
  else
  begin
    say("shell: spawn failed\n");
  end;

  // Command loop. Staged line discipline (spec 0005, Q44): the kernel echoes
  // the typed bytes and completes one line; `core.read_line` blocks until it
  // is ready. Buffer equality compares the runtime length and then the bytes,
  // so `line = "help"` works even though the capacities differ.
  //
  // There is no `return` yet, so `main` ends by leaving the loop with `done`.
  done := false;
  while not done do
  begin
    say("shell> ");
    code := core.read_line(line);
    if line = "help" then
      say("shell: help, hello, exit\n")
    else if line = "hello" then
      say("hello from igis-v2\n")
    else if line = "exit" then
      done := true
    else
      say("unknown\n");
  end;

  say("bye\n");
end;
